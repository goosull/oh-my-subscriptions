#!/usr/bin/env python3
"""oms - one terminal, many AI subscriptions.

Keeps each Claude / Codex account in its own profile directory, shows what each
plan window has left, and refuses to launch an account that could bill you.

Everything it reads is either a documented extension point or a file the vendor's
own CLI wrote on your disk. It never calls a vendor API and never handles a token.
"""
import json, os, re, subprocess, sys, time
from pathlib import Path

OMS = Path(os.environ.get("OMS_HOME", Path.home() / ".oms"))
CFG, USAGE = OMS / "config.json", OMS / "usage"
DEFAULT_CLAUDE_DIR = Path.home() / ".claude"
# Shared from ~/.claude into alt claude profiles so a second account is not a bare install.
SHARED = ["skills", "plugins", "agents", "commands", "settings.json", "CLAUDE.md", "output-styles"]


def die(msg):
    print(f"oms: {msg}", file=sys.stderr)
    sys.exit(1)


def load():
    return json.loads(CFG.read_text()) if CFG.exists() else {"accounts": [], "block_at": 95}


def save(cfg):
    OMS.mkdir(parents=True, exist_ok=True)
    CFG.write_text(json.dumps(cfg, indent=2))


def find(cfg, name):
    for a in cfg["accounts"]:
        if a["name"] == name:
            return a
    die(f"no such account: {name} (have: {', '.join(a['name'] for a in cfg['accounts']) or 'none'})")


# --- usage: claude ------------------------------------------------------------
# Claude Code hands `rate_limits` to the statusLine command on stdin (documented).
# `oms statusline` records it per account; this reads back what it recorded.

def claude_usage(acct):
    f = USAGE / f"{acct['name']}.json"
    if not f.exists():
        return {"err": "no data yet - run this account once"}
    d = json.loads(f.read_text())
    rl = d.get("rate_limits") or {}
    fh, sd = rl.get("five_hour") or {}, rl.get("seven_day") or {}
    if not fh and not sd:
        return {"err": "no rate_limits in last session"}
    pct = max(fh.get("used_percentage") or 0, sd.get("used_percentage") or 0)
    hot = fh if (fh.get("used_percentage") or 0) >= (sd.get("used_percentage") or 0) else sd
    return {"plan": "-", "pct": pct, "resets": hot.get("resets_at"),
            "short_pct": fh.get("used_percentage") if fh else None,
            "window": "5h" if hot is fh else "7d",
            "windows": [(l, w.get("used_percentage") or 0)
                        for w, l in ((fh, "5h"), (sd, "7d")) if w],
            "age": time.time() - d.get("at", 0),
            "paid_on": bool(acct.get("paid_overflow", True)),
            "detail": f"5h {fh.get('used_percentage', 0):.0f}% / 7d {sd.get('used_percentage', 0):.0f}%"}


# --- usage: codex -------------------------------------------------------------
# The codex CLI writes rate_limits into its own session rollout files. Read the
# newest one in this profile; no network, no token.

# Bump whenever the shape of a usage dict changes, so a cache written by an older
# build is discarded instead of quietly serving a record with fields missing.
CACHE_V = 3


def codex_usage(acct):
    c = USAGE / f"{acct['name']}.codex-cache.json"
    if c.exists() and time.time() - c.stat().st_mtime < 60:
        d = json.loads(c.read_text())
        if d.pop("v", 0) == CACHE_V:
            d["age"] = time.time() - d.pop("at", time.time())
            return d
    u = _codex_scan(acct)
    if not u.get("err"):
        USAGE.mkdir(parents=True, exist_ok=True)
        c.write_text(json.dumps({**u, "at": time.time() - u["age"], "v": CACHE_V}))
    return u


def _codex_scan(acct):
    sess = Path(acct["dir"]) / "sessions"
    if not sess.is_dir():
        return {"err": "no data yet - run this account once"}
    files = sorted(sess.rglob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    for f in files[:10]:
        line = None
        for l in f.open(errors="ignore"):
            if '"rate_limits"' in l:
                line = l
        if not line:
            continue
        rl = json.loads(line)["payload"]["rate_limits"]
        pw, sw = rl.get("primary") or {}, rl.get("secondary") or {}
        cr = rl.get("credits") or {}
        pct = max(pw.get("used_percent") or 0, sw.get("used_percent") or 0)
        hot = pw if (pw.get("used_percent") or 0) >= (sw.get("used_percent") or 0) else sw
        short = next((w.get("used_percent") for w in (pw, sw)
                      if w and (w.get("window_minutes") or 10**9) <= 360), None)
        return {"plan": rl.get("plan_type", "?"), "pct": pct, "resets": hot.get("resets_at"),
                "short_pct": short, "window": _win(hot.get("window_minutes")),
                "windows": [(_win(w.get("window_minutes")), w.get("used_percent") or 0)
                            for w in (pw, sw) if w],
                "age": time.time() - f.stat().st_mtime,
                "paid_on": bool(cr.get("has_credits")) or float(cr.get("balance") or 0) > 0,
                "detail": _cdetail(pw, sw)}
    return {"err": "no rate_limits recorded yet"}


def _cdetail(pw, sw):
    s = f"{_win(pw.get('window_minutes'))} {pw.get('used_percent', 0):.0f}%"
    if sw:
        s += f" / {_win(sw.get('window_minutes'))} {sw.get('used_percent', 0):.0f}%"
    return s


def _win(mins):
    if not mins:
        return "?"
    h = mins // 60
    return f"{h}h" if h < 48 else f"{h // 24}d"


def usage(acct):
    return (claude_usage if acct["vendor"] == "claude" else codex_usage)(acct)


def _until(ts):
    if not ts:
        return "-"
    s = int(float(ts) - time.time())
    if s <= 0:
        return "now"
    return f"{s // 86400}d {s % 86400 // 3600}h" if s >= 86400 else f"{s // 3600}h {s % 3600 // 60}m"


def _ago(sec):
    if sec is None:
        return "?"
    return f"{int(sec // 86400)}d" if sec >= 86400 else (f"{int(sec // 3600)}h" if sec >= 3600 else f"{int(sec // 60)}m")


# --- policy -------------------------------------------------------------------

def blocked(acct, u, block_at):
    """Could running this account bill you? -> reason or None."""
    if u.get("err"):
        return u["err"]
    if not u["paid_on"]:
        return None  # plan-only: it stops at the ceiling instead of charging
    if u["pct"] >= acct.get("block_at", block_at):
        return f"{u['pct']:.0f}% used and paid overflow is on for this account"
    return None


# --- commands -----------------------------------------------------------------

def cmd_status(cfg, args):
    if not cfg["accounts"]:
        die("no accounts yet. try: oms add work claude --dir ~/.claude")
    w = max(max(len(a["name"]) for a in cfg["accounts"]), 7)
    print(f"{'ACCOUNT':<{w}}  {'VENDOR':<6} {'PLAN':<6} {'USED':<22} {'RESETS':<9} {'AS OF':<6} PAID")
    for a in cfg["accounts"]:
        u = usage(a)
        if u.get("err"):
            print(f"{a['name']:<{w}}  {a['vendor']:<6} {'-':<6} {('! ' + u['err'])[:22]:<22} {'-':<9} {'-':<6} -")
            continue
        b = blocked(a, u, cfg["block_at"])
        print(f"{a['name']:<{w}}  {a['vendor']:<6} {u['plan'][:6]:<6} {u['detail']:<22} "
              f"{_until(u['resets']):<9} {_ago(u.get('age')):<6} "
              f"{'ON' if u['paid_on'] else 'OFF'}{'  <- BLOCKED' if b else ''}")
    print("\n'AS OF' is how stale the number is: it updates when you actually use that account.")


def cmd_add(cfg, args):
    if len(args) < 2 or args[1] not in ("claude", "codex"):
        die("usage: oms add <name> <claude|codex> [--dir PATH] [--paid-overflow yes|no]")
    name, vendor = args[0], args[1]
    d = os.path.expanduser(args[args.index("--dir") + 1]) if "--dir" in args else str(OMS / "accounts" / name)
    Path(d).mkdir(parents=True, exist_ok=True)
    if vendor == "claude" and Path(d) != DEFAULT_CLAUDE_DIR:
        for s in SHARED:
            src, dst = DEFAULT_CLAUDE_DIR / s, Path(d) / s
            if src.exists() and not dst.exists():
                dst.symlink_to(src)
    acct = {"name": name, "vendor": vendor, "dir": d}
    if vendor == "claude":
        # codex reports its own credit balance; claude's overage flag is org-side, so ask.
        v = args[args.index("--paid-overflow") + 1] if "--paid-overflow" in args else "yes"
        acct["paid_overflow"] = v.lower() in ("yes", "true", "1")
    cfg["accounts"] = [a for a in cfg["accounts"] if a["name"] != name] + [acct]
    save(cfg)
    print(f"added {name} -> {d}")
    print(f"log in with:  oms run {name}" + ("   (then /login inside)" if vendor == "claude" else ""))


def env_for(acct):
    e = dict(os.environ)
    for k in ("OPENAI_API_KEY", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"):
        e.pop(k, None)  # an API key would turn plan usage into metered usage
    e["CLAUDE_CONFIG_DIR" if acct["vendor"] == "claude" else "CODEX_HOME"] = acct["dir"]
    e["OMS_ACCOUNT"] = acct["name"]
    return e


def cmd_run(cfg, args, check=True):
    if not args:
        die("usage: oms run [--force] <account> [cli args...]")
    a = find(cfg, args[0])
    if check:
        u = usage(a)
        if u.get("err"):
            # unknown usage is not evidence of risk, and every fresh profile starts here
            print(f"oms: {a['name']} usage unknown ({u['err']})", file=sys.stderr)
        elif (b := blocked(a, u, cfg["block_at"])):
            die(f"{a['name']} blocked: {b}\n     'oms run --force {a['name']}' to override, "
                f"or 'oms auto {a['vendor']}' to pick another")
    os.execvpe(a["vendor"], [a["vendor"], *args[1:]], env_for(a))


def rank(u):
    """Sort key for auto-selection.

    A 5-hour window refills four or five times a day, so quota left sitting in it when
    it resets is simply gone. A weekly-only pool is a fixed budget that is worth the
    same whenever it is spent. So drain the short windows first and keep the weekly
    pool in reserve. Within each group, whoever has the most room goes first.
    """
    if u.get("short_pct") is not None:
        return (0, u["short_pct"])
    return (1, u["pct"])


def cmd_priority(cfg, args):
    """Show or set an explicit account order for `oms auto`."""
    if args and args[0] in ("--auto", "auto", "reset"):
        cfg.pop("priority", None)
        save(cfg)
        print("priority: automatic (short windows first, then most headroom)")
        return
    if args:
        for n in args:
            find(cfg, n)
        cfg["priority"] = list(args)
        save(cfg)
    order = cfg.get("priority")
    if not order:
        print("priority: automatic - short windows first, then most headroom\n")
        for v in ("claude", "codex"):
            ranked = []
            for a in cfg["accounts"]:
                if a["vendor"] != v:
                    continue
                u = usage(a)
                if u.get("err"):
                    continue
                ranked.append((rank(u), a["name"], u))
            for i, (_, n, u) in enumerate(sorted(ranked), 1):
                why = (f"5h at {u['short_pct']:.0f}%, expires on reset"
                       if u.get("short_pct") is not None else f"weekly pool, {u['pct']:.0f}% used")
                print(f"  {v} {i}. {n:<14} {why}")
        return
    print("priority: explicit\n  " + "\n  ".join(f"{i}. {n}" for i, n in enumerate(order, 1)))
    print("\n  'oms priority --auto' to go back to the automatic rule")


def cmd_auto(cfg, args):
    vendor = args[0] if args and args[0] in ("claude", "codex") else "claude"
    rest = args[1:] if args and args[0] in ("claude", "codex") else args
    order = cfg.get("priority") or []
    cands = []
    for a in cfg["accounts"]:
        if a["vendor"] != vendor:
            continue
        u = usage(a)
        if u.get("err") or blocked(a, u, cfg["block_at"]):
            continue
        key = (order.index(a["name"]),) if a["name"] in order else rank(u)
        cands.append(((a["name"] not in order, key), a, u))
    if not cands:
        die(f"no {vendor} account is both known-good and unblocked. run 'oms status'")
    _, best, bu = min(cands, key=lambda t: t[0])
    why = (f"5h {bu['short_pct']:.0f}%" if bu.get("short_pct") is not None
           else f"weekly {bu['pct']:.0f}%")
    print(f"oms: {best['name']} ({why})", file=sys.stderr)
    os.execvpe(vendor, [vendor, *rest], env_for(best))


# --- status line rendering ---------------------------------------------------
# One strip, scannable in a glance. The account you are in is bright and shows both its
# windows; the rest are dim and show whichever window is binding on them right now.
# Every meter carries its window label, so a number is never ambiguous about which
# quota it describes. Green under 60%, amber above, and red with a leading "!" only
# where continuing would actually cost money.

RESET, DIM, BOLD = "\033[0m", "\033[2m", "\033[1m"
GREEN, YELLOW, RED = "\033[32m", "\033[33m", "\033[31m"


def _tone(pct, is_blocked):
    """Red means money, and only money. A plan with no credit attached can sit at 99%
    without being a problem - it just stops - so a full bar there stays amber."""
    if is_blocked:
        return RED
    return YELLOW if pct >= 60 else GREEN


def _bar(pct, width, colour):
    """Filled run in colour, remainder as a thinner rule so it reads without colour too."""
    filled = max(0, min(width, round(pct / 100 * width)))
    return f"{colour}{'━' * filled}{RESET}{DIM}{'─' * (width - filled)}{RESET}"


def _meter(pct, blocked_, width, label=""):
    c = _tone(pct, blocked_)
    lab = f"{DIM}{label}{RESET} " if label else ""
    return f"{lab}{_bar(pct, width, c)} {c}{pct:.0f}%{RESET}"


def cmd_statusline(cfg, args):
    """Claude Code statusLine command: record this account's rate_limits, draw the strip.

    Any extra args are run as your previous status line and its output is passed through.
    """
    raw = sys.stdin.read()
    try:
        d = json.loads(raw)
    except ValueError:
        d = {}
    name = os.environ.get("OMS_ACCOUNT")
    if not name:  # not launched through oms: match the running config dir to an account
        cur = Path(os.environ.get("CLAUDE_CONFIG_DIR") or DEFAULT_CLAUDE_DIR)
        for a in cfg["accounts"]:
            if a["vendor"] == "claude" and Path(a["dir"]) == cur:
                name = a["name"]
    if name and d.get("rate_limits"):
        USAGE.mkdir(parents=True, exist_ok=True)
        (USAGE / f"{name}.json").write_text(json.dumps(
            {"at": time.time(), "rate_limits": d["rate_limits"]}))
    if args:  # chain to whatever status line you had
        p = subprocess.run(args, input=raw, capture_output=True, text=True)
        sys.stdout.write(p.stdout)
        return

    here = cfg_find_self(cfg, name)
    rl = d.get("rate_limits") or {}
    live = [(l, (rl.get(k) or {}).get("used_percentage") or 0)
            for k, l in (("five_hour", "5h"), ("seven_day", "7d")) if rl.get(k)]

    chips = []
    if live:  # the running session is authoritative for its own account
        limit = (here or {}).get("block_at", cfg["block_at"])
        paid = (here or {}).get("paid_overflow", True)
        chips.append(_group(name or "claude", live,
                            lambda p: paid and p >= limit, True, 8))
    for a in cfg["accounts"]:
        if a["name"] == name:
            continue
        u = usage(a)
        if u.get("err") or not u.get("windows"):
            continue
        b = bool(blocked(a, u, cfg["block_at"]))
        chips.append(_group(a["name"], u["windows"], lambda p, b=b: b, False, 5))
    if chips:
        for row in _pack(chips, int(os.environ.get("COLUMNS") or 80)):
            print(row)


def _group(label, windows, is_blocked, active, width):
    meters = "  ".join(_meter(p, is_blocked(p), width, lab) for lab, p in windows)
    warn = f"{RED}!{RESET}" if any(is_blocked(p) for _, p in windows) else ""
    name = f"{BOLD}{label}{RESET}" if active else f"{DIM}{label}{RESET}"
    return f"{warn}{name} {meters}"


def _wide(t):
    return len(re.sub(r"\x1b\[[0-9;]*m", "", t))


def _pack(chips, columns, max_rows=3):
    """Fill each row up to the terminal width, then start another.

    The status line cannot scroll and is truncated if it overruns, so with enough
    accounts the only choices are wrapping or dropping some. Wrap, but stop at a few
    rows so a long account list can never swallow the screen.
    """
    sep = f"  {DIM}│{RESET}  "
    rows, cur = [], []
    for c in chips:
        trial = cur + [c]
        if cur and _wide(sep.join(trial)) > columns:
            rows.append(cur)
            cur = [c]
        else:
            cur = trial
    if cur:
        rows.append(cur)
    if len(rows) > max_rows:
        dropped = sum(len(r) for r in rows[max_rows:])
        rows = rows[:max_rows]
        rows[-1].append(f"{DIM}+{dropped} more{RESET}")
    return [sep.join(r) for r in rows]


def cfg_find_self(cfg, name):
    for a in cfg["accounts"]:
        if a["name"] == name:
            return a
    return None


def cmd_install(cfg, args):
    """Wire `oms statusline` into settings.json, chaining any existing status line."""
    s = DEFAULT_CLAUDE_DIR / "settings.json"
    d = json.loads(s.read_text()) if s.exists() else {}
    prev = d.get("statusLine")
    me = str(Path(__file__).resolve())
    if isinstance(prev, dict) and "oms statusline" in str(prev.get("command", "")):
        print("already installed")
        return
    cmd = f"{me} statusline"
    if isinstance(prev, dict) and prev.get("command"):
        cmd += " " + prev["command"]
        print(f"chaining your existing status line: {prev['command']}")
    d["statusLine"] = {"type": "command", "command": cmd}
    s.write_text(json.dumps(d, indent=2))
    print(f"installed into {s}\nrestart claude, then 'oms status' will see this account's usage.")


def cmd_login(cfg, args):
    """Log in to a new account first, name it after. `oms login codex`"""
    if not args or args[0] not in ("claude", "codex"):
        die("usage: oms login <claude|codex>")
    vendor = args[0]
    tmp = OMS / "pending" / f"{vendor}-{int(time.time())}"
    tmp.mkdir(parents=True, exist_ok=True)
    e = dict(os.environ)
    for k in ("OPENAI_API_KEY", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"):
        e.pop(k, None)
    e["CLAUDE_CONFIG_DIR" if vendor == "claude" else "CODEX_HOME"] = str(tmp)
    if vendor == "claude":
        for sh in SHARED:  # so the login session looks like your normal setup
            src = DEFAULT_CLAUDE_DIR / sh
            if src.exists():
                (tmp / sh).symlink_to(src)
        print("launching claude - run /login inside it, then exit with Ctrl-D")
        cmd = ["claude"]
    else:
        cmd = ["codex", "login"]
    if subprocess.run(cmd, env=e).returncode != 0:
        die(f"login failed; nothing registered. profile left at {tmp}")
    taken = {a["name"] for a in cfg["accounts"]}
    default = next(f"{vendor}-{i}" for i in range(2, 99) if f"{vendor}-{i}" not in taken)
    if sys.stdin.isatty():
        try:
            name = input(f"name this account [{default}]: ").strip() or default
        except EOFError:
            name = default
    else:
        # No terminal to ask on, so don't pretend to: take the default and say so loudly.
        name = default
        print(f"\n  no terminal to prompt on, so this is registered as '{name}'."
              f"\n  rename it with:  oms rename {name} <your-name>\n")
    if name in taken:
        die(f"'{name}' is already registered. pick another, profile is at {tmp}")
    dest = OMS / "accounts" / name
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp.rename(dest)
    acct = {"name": name, "vendor": vendor, "dir": str(dest)}
    if vendor == "claude":
        acct["paid_overflow"] = True
    cfg["accounts"].append(acct)
    save(cfg)
    print(f"registered {name} -> {dest}")
    if vendor == "claude":
        print("set 'paid_overflow': false in ~/.oms/config.json if this plan has no credit attached")


def cmd_rename(cfg, args):
    """Rename an account, carrying its recorded usage with it."""
    if len(args) != 2:
        die("usage: oms rename <old> <new>")
    old, new = args
    a = find(cfg, old)
    if any(x["name"] == new for x in cfg["accounts"]):
        die(f"'{new}' is already registered")
    for suffix in (".json", ".codex-cache.json"):
        src = USAGE / f"{old}{suffix}"
        if src.exists():
            src.rename(USAGE / f"{new}{suffix}")
    d = Path(a["dir"])
    if d.parent == OMS / "accounts" and d.name == old:  # a profile oms created
        d.rename(d.parent / new)
        a["dir"] = str(d.parent / new)
    a["name"] = new
    save(cfg)
    print(f"{old} -> {new}")


def cmd_env(cfg, args):
    a = find(cfg, args[0])
    print(f'export {"CLAUDE_CONFIG_DIR" if a["vendor"] == "claude" else "CODEX_HOME"}="{a["dir"]}"')


def selftest():
    a = {"name": "x"}
    assert blocked(a, {"pct": 99, "paid_on": False}, 95) is None, "plan-only can't bill, never block"
    assert blocked(a, {"pct": 99, "paid_on": True}, 95), "must block possible overage"
    assert blocked(a, {"pct": 50, "paid_on": True}, 95) is None
    assert blocked({"name": "x", "block_at": 40}, {"pct": 50, "paid_on": True}, 95), "per-account limit"
    assert blocked(a, {"err": "nope"}, 95) == "nope", "status still surfaces unknown as a reason"
    assert _win(10080) == "7d" and _win(300) == "5h" and _win(None) == "?"
    assert _until(time.time() + 7260).startswith("2h") and _until(0) == "-"
    assert _until(time.time() - 5) == "now"
    # a short window that resets today outranks any weekly-only pool, however empty
    assert rank({"short_pct": 90, "pct": 90}) < rank({"short_pct": None, "pct": 0})
    assert rank({"short_pct": 10, "pct": 99}) < rank({"short_pct": 80, "pct": 5})
    assert rank({"short_pct": None, "pct": 20}) < rank({"short_pct": None, "pct": 70})
    assert "7d" in _meter(8, False, 6, "7d") and "5h" in _meter(8, False, 6, "5h")
    assert _wide(f"{RED}abc{RESET}") == 3, "width must ignore colour escapes"
    wide = ["x" * 30] * 4
    assert len(_pack(wide, 80)) == 2 and len(_pack(wide, 200)) == 1
    assert "+6 more" in _pack(["y" * 30] * 12, 80, max_rows=3)[-1]
    print("ok")


CMDS = {"status": cmd_status, "add": cmd_add, "run": cmd_run, "auto": cmd_auto,
        "login": cmd_login, "rename": cmd_rename, "priority": cmd_priority,
        "statusline": cmd_statusline, "install": cmd_install, "env": cmd_env}
USAGE_TEXT = __doc__ + """
  oms login <claude|codex>             log in to a new account, then name it
  oms add <name> <claude|codex> [--dir PATH] [--paid-overflow yes|no]
  oms install                          wire usage recording into ~/.claude/settings.json
  oms status                           what every account has left
  oms run [--force] <name> [args...]   launch one account
  oms auto <claude|codex> [args...]    launch the freest account that can't bill you
  oms rename <old> <new>               rename an account, keeping its usage history
  oms priority [<name>... | --auto]    show or set the order `oms auto` picks in
  oms env <name>                       print the export line for a shell
"""

if __name__ == "__main__":
    argv = sys.argv[1:]
    if argv and argv[0] == "--selftest":
        selftest(); sys.exit(0)
    if not argv or argv[0] not in CMDS:
        print(USAGE_TEXT); sys.exit(0 if argv else 1)
    force = "--force" in argv[1:]
    rest = [x for x in argv[1:] if x != "--force"]
    if argv[0] == "run":
        cmd_run(load(), rest, check=not force)
    else:
        CMDS[argv[0]](load(), rest)

#!/usr/bin/env python3
"""oms - one terminal, many AI subscriptions.

Keeps each Claude / Codex account in its own profile directory, shows what each
plan window has left, and refuses to launch an account that could bill you.

Everything it reads is either a documented extension point or a file the vendor's
own CLI wrote on your disk. It never calls a vendor API and never handles a token.
"""
import json, os, re, subprocess, sys, time
from pathlib import Path

# This program narrates work it then hands to a subprocess, or to die(). Those write
# straight through while our own prints sit in a block buffer, so the explanation
# arrives after the thing it explains. Three separate fixes for that were three prints
# remembering to flush; this is the whole class.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(line_buffering=True)

OMS = Path(os.environ.get("OMS_HOME", Path.home() / ".oms"))
CFG, USAGE = OMS / "config.json", OMS / "usage"
DEFAULT_CLAUDE_DIR = Path.home() / ".claude"
CORE_RELEASE = "0.33.1"
# Shared from ~/.claude into alt claude profiles so a second account is not a bare install.
SHARED = ["skills", "plugins", "agents", "commands", "settings.json", "CLAUDE.md", "output-styles"]


def die(msg):
    print(f"oms: {msg}", file=sys.stderr)
    sys.exit(1)


def load():
    if not CFG.exists():
        return {"accounts": [], "block_at": 95}
    try:
        return json.loads(CFG.read_text())
    except ValueError as e:
        die(f"{CFG} is not valid JSON ({e}).\n"
            f"  fix it, or move it aside and start over:  mv {CFG} {CFG}.broken")


def write_json(path, obj):
    """Write through a temp file in the same directory, then rename.

    A half-written config is an account list lost. rename is atomic on the same
    filesystem, so a reader sees either the old file or the new one, never a torn one.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}")
    tmp.write_text(json.dumps(obj, indent=2))
    tmp.replace(path)


def save(cfg):
    write_json(CFG, cfg)


def find(cfg, name):
    for a in cfg["accounts"]:
        if a["name"] == name:
            return a
    die(f"no such account: {name} (have: {', '.join(a['name'] for a in cfg['accounts']) or 'none'})")


def _route(cfg, name):
    return next((r for r in (cfg.get("pi") or {}).get("routes", [])
                 if r.get("account") == name), None)


def _account_names(cfg):
    return list(dict.fromkeys([*(a["name"] for a in cfg["accounts"]),
                               *(r.get("account") for r in (cfg.get("pi") or {}).get("routes", [])
                                 if r.get("account"))]))


# --- usage: claude ------------------------------------------------------------
# Claude Code hands `rate_limits` to the statusLine command on stdin (documented).
# `oms statusline` records it per account; this reads back what it recorded.

def claude_usage(acct):
    f = USAGE / f"{acct['name']}.json"
    if not f.exists():
        return {"err": "no data yet - run this account once"}
    d = json.loads(f.read_text())
    rl = d.get("rate_limits") or {}
    fh, sd = rl.get("five_hour") or {}, rl.get("seven_day") or {}
    if not fh and not sd:
        return {"err": "no rate_limits in last session"}
    hot = fh if (fh.get("used_percentage") or 0) >= (sd.get("used_percentage") or 0) else sd
    return reading([(l, w.get("used_percentage")) for w, l in ((fh, "5h"), (sd, "7d")) if w],
                   resets=hot.get("resets_at"), age=time.time() - d.get("at", 0),
                   paid_on=acct.get("paid_overflow", True))


# --- usage: codex -------------------------------------------------------------
# The codex CLI writes rate_limits into its own session rollout files. Read the
# newest one in this profile; no network, no token.

# Bump whenever the shape of a usage dict changes, so a cache written by an older
# build is discarded instead of quietly serving a record with fields missing.
CACHE_V = 6
CACHE_TTL = 60


TRAIL_MAX = 400


def note_sample(acct, u):
    """Append what this account had used, so a pace can be worked out later.

    A snapshot answers "am I about to overshoot". It cannot answer the other half of the
    question - whether a plan is on course to be spent at all - and quota left unspent
    when a window resets is as wasted as quota overspent is expensive.
    """
    if u.get("err") or not u.get("resets"):
        return
    f = USAGE / f"{acct['name']}.trail.jsonl"
    try:
        line = json.dumps({"at": int(time.time()), "pct": round(u["pct"], 2),
                           "resets": int(float(u["resets"]))})
        old = f.read_text().splitlines() if f.exists() else []
        # keep only this window: a reading from before the last reset says nothing
        keep = [l for l in old[-TRAIL_MAX:]
                if l and json.loads(l).get("resets") == int(float(u["resets"]))]
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text("\n".join([*keep, line]) + "\n")
    except (OSError, ValueError):
        pass


def pace(acct, u):
    """Where this window lands if the last few hours continue. None when unknowable."""
    f = USAGE / f"{acct['name']}.trail.jsonl"
    try:
        rows = [json.loads(l) for l in f.read_text().splitlines() if l]
    except (OSError, ValueError):
        return None
    rows = [r for r in rows if r.get("resets") == int(float(u.get("resets") or 0))]
    if len(rows) < 2:
        return None
    span = rows[-1]["at"] - rows[0]["at"]
    burn = rows[-1]["pct"] - rows[0]["pct"]
    if span < 900 or burn <= 0:                      # too short, or not moving
        return None
    left = max(0.0, float(u["resets"]) - time.time())
    projected = u["pct"] + burn / span * left
    return {"per_hour": burn / span * 3600, "projected": projected,
            "hits_at": time.time() + (100 - u["pct"]) / (burn / span) if burn else None}


def cached(acct, read):
    """Memoise a reading briefly. Every provider needs this: codex spawns a subprocess,
    kiro walks a session history that only grows, and the status line re-renders often."""
    c = USAGE / f"{acct['name']}.cache.json"
    try:
        if time.time() - c.stat().st_mtime < CACHE_TTL:
            d = json.loads(c.read_text())
            if d.pop("v", 0) == CACHE_V:
                d["age"] = time.time() - d.pop("at", time.time())
                return d
    except (OSError, ValueError):
        pass
    u = read(acct)
    if not u.get("err"):
        try:
            write_json(c, {**u, "at": time.time() - u.get("age", 0), "v": CACHE_V})
        except OSError:
            pass
    return u


def codex_usage(acct):
    return cached(acct, lambda a: _from_rpc(a, _codex_rpc(a)) or _codex_scan(a))


def _codex_rpc(acct, timeout=12):
    """Ask codex itself, over the JSON-RPC protocol its app-server speaks.

    Better than reading the rollout files: it answers for an account you have not used
    lately instead of replaying the last conversation's snapshot, and it carries the
    absolute credit allowance the rollouts leave out.
    """
    import threading
    try:
        pr = subprocess.Popen([provider(acct)["bin"], "app-server"],
                              stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, text=True, env=env_for(acct))
    except OSError:
        return None
    got = {}

    def pump():
        for line in pr.stdout:
            try:
                m = json.loads(line)
            except ValueError:
                continue
            if m.get("id") == 2:
                got["r"] = m.get("result")
                break
    t = threading.Thread(target=pump, daemon=True)
    t.start()
    try:
        for msg in ({"jsonrpc": "2.0", "id": 1, "method": "initialize",
                     "params": {"clientInfo": {"name": "oms", "title": "oms",
                                               "version": "1"}}},
                    {"jsonrpc": "2.0", "id": 2, "method": "account/rateLimits/read",
                     "params": {}}):
            pr.stdin.write(json.dumps(msg) + "\n")
        pr.stdin.flush()
        t.join(timeout)
    except (BrokenPipeError, OSError):
        pass
    finally:
        pr.kill()
    return got.get("r")


def _from_rpc(acct, r):
    rl = (r or {}).get("rateLimits") or {}
    pw, sw = rl.get("primary") or {}, rl.get("secondary") or {}
    if not pw and not sw:
        return None
    cr, il = rl.get("credits") or {}, rl.get("individualLimit") or {}
    wins = [(_win(w.get("windowDurationMins")), w.get("usedPercent")) for w in (pw, sw) if w]
    hot = pw if (pw.get("usedPercent") or 0) >= (sw.get("usedPercent") or 0) else sw
    detail = "  ".join(f"{l} {float(p or 0):.0f}%" for l, p in wins)
    if il.get("limit"):
        detail += f"  ({float(il.get('used') or 0):.0f}/{float(il['limit']):.0f} cr)"
    return reading(wins, plan=rl.get("planType"), resets=hot.get("resetsAt"), detail=detail,
                   size=float(il["limit"]) if il.get("limit") else None,
                   paid_on=bool(cr.get("hasCredits")) or float(cr.get("balance") or 0) > 0)


def _codex_scan(acct):
    sess = Path(acct["dir"]) / "sessions"
    if not sess.is_dir():
        return {"err": "no data yet - run this account once"}
    files = sorted(sess.rglob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    for f in files[:10]:
        line = None
        for l in f.open(errors="ignore"):
            if '"rate_limits"' in l:
                line = l
        if not line:
            continue
        rl = json.loads(line)["payload"]["rate_limits"]
        pw, sw = rl.get("primary") or {}, rl.get("secondary") or {}
        cr = rl.get("credits") or {}
        hot = pw if (pw.get("used_percent") or 0) >= (sw.get("used_percent") or 0) else sw
        return reading([(_win(w.get("window_minutes")), w.get("used_percent"))
                        for w in (pw, sw) if w],
                       plan=rl.get("plan_type"), resets=hot.get("resets_at"),
                       age=time.time() - f.stat().st_mtime, detail=_cdetail(pw, sw),
                       paid_on=bool(cr.get("has_credits")) or float(cr.get("balance") or 0) > 0)
    return {"err": "no rate_limits recorded yet"}


def _cdetail(pw, sw):
    s = f"{_win(pw.get('window_minutes'))} {pw.get('used_percent', 0):.0f}%"
    if sw:
        s += f" / {_win(sw.get('window_minutes'))} {sw.get('used_percent', 0):.0f}%"
    return s


def reading(windows, *, plan="-", resets=None, paid_on=False, age=0, detail=None, **extra):
    """The one definition of a usage reading. Every provider goes through here.

    `windows` is [(label, used_percent)] and the two that matter are named, because
    they are different windows and confusing them is this file's favourite mistake:

      binding  the fullest one - what will stop you first, so it is the headline
      soonest  the one that resets first - what evaporates if you do not spend it,
               so it is what the pick order runs on

    Deriving either anywhere else is how the same bug arrived three times.
    """
    wins = [(l, float(p or 0)) for l, p in windows]
    binding = max(wins, key=lambda w: w[1], default=("?", 0.0))
    soonest = min(wins, key=lambda w: _mins(w[0]), default=("?", 0.0))
    return {"plan": plan or "-", "pct": binding[1], "window": binding[0], "windows": wins,
            "binding": list(binding), "soonest": list(soonest),
            "resets": resets, "paid_on": bool(paid_on), "age": age,
            "detail": detail if detail is not None else "  ".join(f"{l} {p:.0f}%" for l, p in wins),
            **extra}


def _win(mins):
    if not mins:
        return "?"
    h = mins // 60
    return f"{h}h" if h < 48 else f"{h // 24}d"


# --- usage: kiro --------------------------------------------------------------
# kiro-cli has no usage command - `user` is only login/logout/whoami, `profile` is for
# IdC accounts, and the real balance lives server-side behind `kiro-cli dashboard`, which
# just opens a browser. What it does leave on disk is the cost of each turn, in credits,
# under session_state.conversation_metadata.user_turn_metadatas[].metering_usage.
#
# Summing those is a floor, not a balance: it counts only CLI turns made through this
# profile, so IDE and web spend is invisible, and it goes stale if sessions are pruned.
# It is reported with a leading ">=" so it is never mistaken for the real figure.

def kiro_usage(acct):
    return cached(acct, _kiro_scan)


def _kiro_scan(acct):
    size = acct.get("size")
    if not size:
        return {"err": "set size=<plan credits> to track"}
    start = _period_start(acct.get("resets_on", 1))
    used, seen = 0.0, False
    for f in (Path(acct["dir"]) / "sessions").rglob("*.json"):
        try:
            d = json.loads(f.read_text(errors="ignore"))
        except ValueError:
            continue
        if (d.get("updated_at") or "") < start:
            continue
        for t in ((d.get("session_state") or {}).get("conversation_metadata")
                  or {}).get("user_turn_metadatas") or []:
            for m in t.get("metering_usage") or []:
                if m.get("unit") == "credit":
                    used += float(m.get("value") or 0)
                    seen = True
    if not seen:
        return {"err": "no metered turns yet"}
    pct = min(100.0, used / float(size) * 100)
    return reading([("30d", pct)], resets=_period_end(acct.get("resets_on", 1)),
                   paid_on=acct.get("paid_overflow", False), floor=True, size=float(size),
                   detail=f"30d >={pct:.0f}% ({used:.1f}/{size:g} cr, cli only)")


def _period_start(day):
    """ISO timestamp of the current monthly period's first day, in UTC."""
    import datetime as dt
    now = dt.datetime.now(dt.timezone.utc)
    first = now.replace(day=min(day, 28), hour=0, minute=0, second=0, microsecond=0)
    if first > now:
        first = (first.replace(day=1) - dt.timedelta(days=1)).replace(day=min(day, 28))
    return first.isoformat().replace("+00:00", "Z")


def _period_end(day):
    import datetime as dt
    start = dt.datetime.fromisoformat(_period_start(day).replace("Z", "+00:00"))
    nxt = (start.replace(day=28) + dt.timedelta(days=7)).replace(day=min(day, 28))
    return nxt.timestamp()


# --- providers ----------------------------------------------------------------
# Everything provider-specific lives here, so adding one is a table entry rather than
# a hunt through the file. A provider that is not installed is still a provider: oms
# registers the account and tells you how to install it.

PROVIDERS = {
    "claude": {
        "bin": "claude",
        "home": "CLAUDE_CONFIG_DIR",
        "install": [("npm", ["npm", "install", "-g", "@anthropic-ai/claude-code"])],
        "login": None,  # there is no login subcommand; you run /login inside a session
        "launch": [],
        "prime": ["-p", "ok"],
        "usage": lambda a: claude_usage(a),
        "shared_auth": False,
        "flags": {"model": lambda v: ["--model", v],
                  "effort": lambda v: ["--effort", v]},
        "efforts": ["low", "medium", "high", "xhigh", "max"],
    },
    "codex": {
        "bin": "codex",
        "home": "CODEX_HOME",
        "install": [("npm", ["npm", "install", "-g", "@openai/codex"])],
        "login": ["login"],
        "launch": [],
        "prime": ["exec", "ok"],
        "usage": lambda a: codex_usage(a),
        "shared_auth": False,
        "flags": {"model": lambda v: ["-m", v],
                  "effort": lambda v: ["-c", f'model_reasoning_effort="{v}"'],
                  "context": lambda v: ["-c", f"model_context_window={v}"]},
        "efforts": ["minimal", "low", "medium", "high", "xhigh", "max"],
    },
    "kiro": {
        "bin": "kiro-cli",
        "home": "KIRO_HOME",
        "install": [("brew", ["brew", "install", "--cask", "kiro-cli"]),
                    ("curl", ["bash", "-c", "curl -fsSL https://cli.kiro.dev/install | bash"])],
        "login": ["login"],
        "launch": ["chat"],
        # appended after `launch`, so this must not repeat the `chat` subcommand
        "prime": ["--no-interactive", "--trust-all-tools", "ok"],
        # KIRO_HOME moves settings and sessions but not the login: the credential is a
        # single machine-wide keychain entry (kirocli:social:token), and a brand new
        # KIRO_HOME still reports the existing account. So one Kiro login at a time.
        "shared_auth": True,
        "usage": lambda a: kiro_usage(a),
        "flags": {},
        "efforts": [],
    },
}


def provider(acct):
    return PROVIDERS[acct["vendor"]]


def warn_shared_auth(cfg, vendor, this=None):
    """Say plainly when a provider cannot hold two logins at once."""
    if not PROVIDERS[vendor]["shared_auth"]:
        return
    others = [a["name"] for a in cfg["accounts"]
              if a["vendor"] == vendor and a["name"] != this]
    if others:
        print(f"note: {vendor} keeps one login per machine, so this shares a session with "
              f"{', '.join(others)}. logging in here signs those out.", file=sys.stderr)


def installed(vendor):
    from shutil import which
    return which(PROVIDERS[vendor]["bin"]) is not None


def _install_cmd(vendor):
    """First install route whose own tool is actually present."""
    from shutil import which
    for needs, cmd in PROVIDERS[vendor]["install"]:
        if which(needs):
            return cmd
    return None


def ensure_installed(vendor, allow_install=True):
    """Install a provider's CLI if it is missing. Returns True once it is there.

    No confirmation: you named the provider, and installing its CLI is the prerequisite
    of what you asked for, not a surprise. The command is echoed before it runs, and
    --no-install refuses instead.
    """
    if installed(vendor):
        return True
    p = PROVIDERS[vendor]
    cmd = _install_cmd(vendor)
    if not cmd:
        die(f"{p['bin']} is not installed, and no install route is available here.\n"
            f"  tried: {', '.join(n for n, _ in p['install'])}")
    shown = " ".join(cmd[2:]) if cmd[0] == "bash" else " ".join(cmd)
    if not allow_install:
        die(f"{p['bin']} is not installed. install it with:\n  {shown}")
    print(f"installing {p['bin']}\n$ {shown}")
    if subprocess.run(cmd).returncode != 0:
        die(f"install failed. try it by hand:\n  {shown}")
    if not installed(vendor):
        die(f"{p['bin']} still is not on PATH. open a new shell and try again.")
    return True


def usage_all(accounts):
    """Read every account at once. Each read waits on its own subprocess or disk walk,
    so doing them in sequence made status cost the sum rather than the slowest."""
    if len(accounts) < 2:
        return [usage(a) for a in accounts]
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=min(8, len(accounts))) as pool:
        return list(pool.map(usage, accounts))


def usage(acct):
    p = provider(acct)
    if not p["usage"]:
        return {"err": f"{acct['vendor']} reports no usage"}
    if not installed(acct["vendor"]):
        return {"err": f"{p['bin']} not installed"}
    u = p["usage"](acct)
    note_sample(acct, u)
    return u


def _until(ts):
    if not ts:
        return "-"
    s = int(float(ts) - time.time())
    if s <= 0:
        return "now"
    return f"{s // 86400}d {s % 86400 // 3600}h" if s >= 86400 else f"{s // 3600}h {s % 3600 // 60}m"


def _pace_text(p):
    """Where the window lands, or why we cannot say yet."""
    if not p:
        return "-"
    if p["projected"] >= 100:
        return f"full in {_until(p['hits_at'])}"
    return f"{p['projected']:.0f}% by reset"


def _ago(sec):
    if sec is None:
        return "?"
    return f"{int(sec // 86400)}d" if sec >= 86400 else (f"{int(sec // 3600)}h" if sec >= 3600 else f"{int(sec // 60)}m")


# --- policy -------------------------------------------------------------------

def stale(u):
    """Has this reading aged enough that the window could have moved under it?

    A quarter of the window it describes: 75 minutes for a 5-hour window, a day and a
    half for a weekly one. Past that the number is history, and a guard reasoning from
    history is not a guard - a claude account read before the last session could be
    anywhere by now.
    """
    wins = u.get("windows") or []
    if u.get("err") or not wins:
        return False
    soonest = min(_mins(l) for l, _ in wins)
    return (u.get("age") or 0) > soonest * 60 / 4


def blocked(acct, u, block_at):
    """Could running this account bill you? -> reason or None."""
    if u.get("err"):
        return u["err"]

    if not u["paid_on"]:
        return None  # plan-only: it stops at the ceiling instead of charging
    if u["pct"] >= acct.get("block_at", block_at):
        return f"{u['pct']:.0f}% used and paid overflow is on for this account"
    return None


# --- commands -----------------------------------------------------------------

def cmd_status(cfg, args):
    if "--json" in args:
        return _status_json(cfg)
    if not cfg["accounts"]:
        die(f"no accounts yet. try:  oms login <{'|'.join(PROVIDERS)}>")
    rows, blocked_any = [], False
    for a, u in zip(cfg["accounts"], usage_all(cfg["accounts"])):
        if u.get("err"):
            rows.append([a["name"], a["vendor"], "-", "! " + u["err"], "-", "-", "-", "-"])
            continue
        b = blocked(a, u, cfg["block_at"])
        blocked_any = blocked_any or bool(b)
        rows.append([a["name"], a["vendor"], (u["plan"] or "-")[:8], u["detail"],
                     _until(u["resets"]), _pace_text(pace(a, u)),
                     _ago(u.get("age")) + (" stale" if stale(u) else ""),
                     ("BLOCKED" if b else "at risk") if u["paid_on"] else "no"])
    head = ["ACCOUNT", "VENDOR", "PLAN", "USED", "RESETS", "ON PACE FOR", "AS OF", "BILLS?"]
    # widths come from the data; a long reading must not shove every later column right
    w = [max(len(r[i]) for r in [head] + rows) for i in range(len(head))]
    print("  ".join(h.ljust(w[i]) for i, h in enumerate(head)).rstrip())
    for r in rows:
        print("  ".join(c.ljust(w[i]) for i, c in enumerate(r)).rstrip())
    print("\nON PACE FOR is where this window lands if the last hours continue - under"
          "\n100% means quota you will not get to spend, over means you run out early."
          "\nAS OF is how stale the reading is. BILLS? is what happens at the ceiling:"
          "\n  no       the plan stops, and costs nothing"
          "\n  at risk  paid overflow is on, so the ceiling is a charge, not a stop"
          "\n  BLOCKED  oms will not launch this account" + (
              "\n\nrun it anyway with:  oms run --force <name>" if blocked_any else ""))


def _core_bindings(cfg):
    return [b for b in (cfg.get("core") or {}).get("bindings", [])
            if b.get("account") and b.get("core_id")]


def _core_usage(binding):
    core_id = re.sub(r"[^A-Za-z0-9_-]", "_", str(binding["core_id"]))
    f = USAGE / f"core-{core_id}.json"
    try:
        d = json.loads(f.read_text())
        wins = [(w["window"], float(w["used_percent"])) for w in d.get("windows", [])]
        if not wins: return {"err": d.get("error") or "core quota unavailable"}
        hot = max(wins, key=lambda item: item[1])
        return reading(wins, plan=d.get("provider") or "core", resets=d.get("resets_at"),
                       age=time.time() - d.get("at", 0), paid_on=bool(binding.get("paid_overflow")),
                       detail="  ".join(f"{label} {pct:.0f}%" for label, pct in wins))
    except (OSError, ValueError, KeyError):
        return {"err": "core quota unavailable - run `oms core sync`"}


def _status_json(cfg):
    """Machine-readable status, already in pick order and already judged.

    Anything consuming this - a router in another language, a script, a status bar -
    should not have to re-derive which account is safe or which comes first. The
    ordering and the `blocked` reason are the policy; everything else is the reading.
    """
    rows = []
    for a, u in zip(cfg["accounts"], usage_all(cfg["accounts"])):
        row = {"name": a["name"], "vendor": a["vendor"], "dir": a["dir"],
               "bin": provider(a)["bin"], "installed": installed(a["vendor"]),
               "flags": launch_flags(a)}
        if u.get("err"):
            row.update(available=False, reason=u["err"])
        else:
            b = blocked(a, u, cfg["block_at"])
            row.update(available=not b and not stale(u), blocked=b, stale=stale(u),
                       plan=u.get("plan"), age_seconds=u.get("age"),
                       used_percent=u["pct"],
                       # named, so a consumer never has to work out which is which -
                       # the mistake this file kept making internally
                       binding={"window": u["binding"][0], "used_percent": u["binding"][1]},
                       soonest={"window": u["soonest"][0], "used_percent": u["soonest"][1]},
                       windows=[{"window": w, "used_percent": p}
                                for w, p in u.get("windows") or []],
                       resets_at=u.get("resets"), pays_on_overflow=u["paid_on"],
                       floor=bool(u.get("floor")),
                       key=[None if isinstance(k, float) and k == float("inf") else k
                            for k in sel_key(cfg, a, u)])
        rows.append(row)
    known = {row["name"] for row in rows}
    for binding in _core_bindings(cfg):
        if binding["account"] in known: continue
        u = _core_usage(binding)
        row = {"name": binding["account"], "vendor": binding.get("provider") or "core",
               "dir": "core:" + str(binding["core_id"]), "bin": "oms-core", "installed": True,
               "flags": []}
        if u.get("err"):
            row.update(available=False, reason=u["err"])
        else:
            synthetic = {"name": binding["account"], "paid_overflow": bool(binding.get("paid_overflow"))}
            b = blocked(synthetic, u, cfg["block_at"])
            row.update(available=not b and not stale(u), blocked=b, stale=stale(u),
                       plan=u.get("plan"), age_seconds=u.get("age"), used_percent=u["pct"],
                       binding={"window": u["binding"][0], "used_percent": u["binding"][1]},
                       soonest={"window": u["soonest"][0], "used_percent": u["soonest"][1]},
                       windows=[{"window": w, "used_percent": p} for w, p in u.get("windows") or []],
                       resets_at=u.get("resets"), pays_on_overflow=u["paid_on"], floor=False,
                       key=[None if isinstance(k, float) and k == float("inf") else k
                            for k in (1, *rank(u, synthetic))])
        rows.append(row)
    rows.sort(key=lambda r: [float("inf") if k is None else k
                             for k in r.get("key") or [9]])
    print(json.dumps({"block_at": cfg["block_at"],
                      "warn_at": cfg.get("warn_at", min(cfg["block_at"], 95) - 10),
                      "priority": cfg.get("priority"), "accounts": rows,
                      # usage_widget is the beta.4 compatibility toggle. New hosts use
                      # usage_display; a saved false still means off after upgrading.
                      "usage_widget": cfg.get("usage_widget", True),
                      "usage_display": cfg.get("usage_display",
                                               "off"),
                      "usage_refresh_seconds": cfg.get("usage_refresh_seconds", 60),
                      "pi_auto": cfg.get("pi_auto")}, indent=2))


def cmd_add(cfg, args):
    if len(args) < 2 or args[1] not in PROVIDERS:
        die(f"usage: oms add <name> <{'|'.join(PROVIDERS)}> [--dir PATH]"
            " [--paid-overflow yes|no]")
    name, vendor = args[0], args[1]
    d = os.path.expanduser(args[args.index("--dir") + 1]) if "--dir" in args else str(OMS / "accounts" / name)
    Path(d).mkdir(parents=True, exist_ok=True)
    if vendor == "claude" and Path(d) != DEFAULT_CLAUDE_DIR:
        for s in SHARED:
            src, dst = DEFAULT_CLAUDE_DIR / s, Path(d) / s
            if src.exists() and not dst.exists():
                dst.symlink_to(src)
    acct = {"name": name, "vendor": vendor, "dir": d}
    if vendor == "claude":
        # codex reports its own credit balance; claude's overage flag is org-side, so ask.
        v = args[args.index("--paid-overflow") + 1] if "--paid-overflow" in args else "yes"
        acct["paid_overflow"] = v.lower() in ("yes", "true", "1")
    cfg["accounts"] = [a for a in cfg["accounts"] if a["name"] != name] + [acct]
    save(cfg)
    print(f"added {name} -> {d}")
    warn_shared_auth(cfg, vendor, name)
    if not installed(vendor):
        print(f"{PROVIDERS[vendor]['bin']} is not installed yet - "
              f"'oms login {vendor}' will install it.")
    print(f"log in with:  oms login {vendor}")


def env_for(acct):
    e = dict(os.environ)
    for k in ("OPENAI_API_KEY", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"):
        e.pop(k, None)  # an API key would turn plan usage into metered usage
    e[provider(acct)["home"]] = acct["dir"]
    e["OMS_ACCOUNT"] = acct["name"]
    return e


HANDOFF = OMS / "handoff.md"
HANDOFF_MAX = 60_000  # keep the brief well clear of the OS argument limit


def cmd_handoff(cfg, args):
    """The note carried into the next session when you switch accounts.

    A session cannot actually move between accounts - its transcript is written with
    the account that owns it - so this carries a brief instead of a conversation. It is
    just text, which is why it also works claude -> codex.
    """
    if args and args[0] == "--clear":
        HANDOFF.unlink(missing_ok=True)
        print("handoff cleared")
        return
    if args:  # `oms handoff -` reads from stdin
        text = sys.stdin.read() if args[0] == "-" else " ".join(args)
        OMS.mkdir(parents=True, exist_ok=True)
        HANDOFF.write_text(text[:HANDOFF_MAX])
        print(f"handoff saved ({len(text)} chars) -> launch with: oms run <account> --handoff")
        return
    if not HANDOFF.exists():
        print("no handoff set.\n  oms handoff -        read a brief from stdin"
              "\n  /oms:handoff         have Claude write one from this session")
        return
    print(HANDOFF.read_text())


def _handoff_prompt():
    if not HANDOFF.exists():
        die("no handoff set. write one with '/oms:handoff' or 'oms handoff -'")
    t = HANDOFF.read_text().strip()
    if not t:
        die("the handoff note is empty")
    return ("Continuing work from another account's session. This is the handoff brief;"
            " pick up from it.\n\n" + t[:HANDOFF_MAX])


def cmd_check(cfg, args):
    """UserPromptSubmit hook: warn while there is still room to hand off."""
    try:
        _check(cfg, args)
    except Exception:
        pass  # a hook that fails must not stand between the user and their prompt


def _check(cfg, args):
    """Warn while there is still room to hand off.

    Claude Code offers to switch accounts only once you have already hit the wall, by
    which point there is no budget left to write a brief with. Fire early instead.
    """
    try:
        d = json.loads(sys.stdin.read())
    except ValueError:
        d = {}
    name = os.environ.get("OMS_ACCOUNT")
    if not name:
        cur = Path(os.environ.get("CLAUDE_CONFIG_DIR") or DEFAULT_CLAUDE_DIR)
        for a in cfg["accounts"]:
            if a["vendor"] == "claude" and Path(a["dir"]) == cur:
                name = a["name"]
    a = cfg_find_self(cfg, name)
    if not a:
        return
    u = usage(a)
    if u.get("err"):
        return
    warn_at = cfg.get("warn_at", min(a.get("block_at", cfg["block_at"]), 95) - 10)
    p = pace(a, u)
    soon = p and p["hits_at"] and p["hits_at"] - time.time() < WARN_WITHIN
    if (u["pct"] < warn_at and not soon) or not _due(a, u["pct"]):
        return
    paid = " Continuing past the limit on this account is billed." if u["paid_on"] else ""
    alt = _best_alt(cfg, a)
    rate = (f" At the last few hours' rate it is full in {_until(p['hits_at'])}."
            if soon else "")
    print(f"<oms-quota>{a['name']} is at {u['pct']:.0f}% of its {u.get('window', '')} "
          f"window, resetting in {_until(u.get('resets'))}.{rate}{paid} "
          f"{alt} Offer the user a handoff now, while there is still context budget to "
          f"write one: use the oms:handoff skill, then give them the launch line. Say "
          f"this once; oms will not raise it again for a while.</oms-quota>")


# Once over the line the hook fires on every prompt, and the warning itself asks not to
# be repeated - so it has to be the thing that stops. Say it again only after an hour,
# or sooner if the situation has actually moved on by another ten points.
WARN_AGAIN_AFTER = 3600
WARN_AGAIN_AT = 10
# A percentage is a proxy for the thing the warning is actually about: whether there is
# still time to hand off. 85% that has not moved all day is nothing; 60% burning fast is
# half an hour from the wall. Warn on the clock too, whatever the percentage says.
WARN_WITHIN = 45 * 60


def _due(acct, pct):
    f = USAGE / f"{acct['name']}.warned.json"
    try:
        last = json.loads(f.read_text())
        if time.time() - last["at"] < WARN_AGAIN_AFTER and pct - last["pct"] < WARN_AGAIN_AT:
            return False
    except (OSError, ValueError, KeyError):
        pass
    try:
        write_json(f, {"at": time.time(), "pct": pct})
    except OSError:
        pass
    return True


def _best_alt(cfg, acct):
    others = [b for b in cfg["accounts"] if b["name"] != acct["name"]]
    cands = [(sel_key(cfg, b, v), b, v) for b, v in zip(others, usage_all(others))
             if not v.get("err") and not stale(v) and not blocked(b, v, cfg["block_at"])]
    if not cands:
        return "No other account has known headroom."
    # Follow the pick order rather than second-guessing it. Billing risk is already
    # handled: nothing reaches this list unless the guard cleared it, and it will be
    # blocked again when it gets close. Preferring an account that cannot bill would
    # override the rule that matters here - spend the window that expires, keep the
    # fixed pool in reserve - so say what the suggestion is and let it stand.
    _, b, v = min(cands, key=lambda t: t[0])
    note = " — it can bill as well, so oms will stop it too" if v["paid_on"] else ""
    return f"`oms run {b['name']} --handoff` has room ({v['pct']:.0f}% used){note}."


# One vocabulary, translated per vendor at launch. The point of oms is that you say
# what you want once; remembering that codex spells effort `-c model_reasoning_effort`
# and claude spells it `--effort` is exactly the work it should be absorbing.
SETTING_KEYS = ("model", "effort", "context")


def launch_flags(acct):
    """Settings for this account, in its own provider's spelling, then any raw args."""
    flags = provider(acct)["flags"]
    out = list(provider(acct)["launch"])
    for key in SETTING_KEYS:
        v = acct.get(key)
        if v is not None and key in flags:
            out += flags[key](str(v))
    return out + list(acct.get("args") or [])


GLOBAL_KEYS = {
    "usage_display": "account usage UI in host integrations: status, widget, or off",
    "usage_widget": "legacy show/hide alias (yes/no; prefer usage_display)",
    "usage_refresh_seconds": "usage UI refresh interval, 15-3600 seconds (default 60)",
    "pi_auto": "enable Pi automatic routing globally (yes/no; confirmed bindings required)",
    "block_at": "default %% at which an account that can bill you is blocked",
    "warn_at": "%% at which the hook offers a handoff (default: block_at - 10)",
    "priority": "comma-separated pick order, or 'auto'",
}
ACCOUNT_KEYS = {
    "name": "what the account is called",
    "size": "how big this plan's pool is, any comparable number; smaller is spent first",
    "resets_on": "day of month the plan's credits reset (kiro)",
    "model": "model to launch with, in that vendor's own model names",
    "effort": "reasoning effort: low, medium, high, xhigh, max (codex also minimal)",
    "context": "context window in tokens (codex only; claude takes it from the model)",
    "args": "extra vendor flags, appended raw ('' to clear)",
    "paid_overflow": "yes if hitting the ceiling on this account is billed",
    "block_at": "override the global block threshold for this account",
}


def _coerce(key, val):
    if not val:
        return None
    if key in ("block_at", "warn_at"):
        if not val.lstrip("-").isdigit():
            die(f"{key} takes a number, got {val!r}")
        return int(val)
    if key == "usage_display":
        if val not in ("status", "widget", "off"):
            die("usage_display takes status, widget, or off")
        return val
    if key in ("usage_widget", "pi_auto"):
        if val.lower() not in ("yes", "no", "true", "false", "1", "0"):
            die(f"{key} takes yes or no")
        return val.lower() in ("yes", "true", "1")
    if key == "usage_refresh_seconds":
        if not val.isdigit() or not 15 <= int(val) <= 3600:
            die("usage_refresh_seconds takes 15-3600 seconds")
        return int(val)
    if key == "paid_overflow":
        return val.lower() in ("yes", "true", "1", "on")
    if key == "args":
        return val.split() or None
    if key == "context":
        if not val.isdigit():
            die(f"context takes a number of tokens, got {val!r}")
        return int(val)
    if key == "resets_on":
        if not val.isdigit() or not 1 <= int(val) <= 28:
            die(f"resets_on takes a day of the month, 1-28; got {val!r}")
        return int(val)
    if key == "size":
        try:
            return float(val)
        except ValueError:
            die(f"size takes a number, got {val!r}")
    if key in ("model", "effort"):
        return val or None
    if key == "priority":
        return None if val in ("auto", "") else [v.strip() for v in val.split(",") if v.strip()]
    return val


def _core_models():
    try:
        import urllib.request
        token = (OMS / "core" / "facade.token").read_text().strip()
        req = urllib.request.Request("http://127.0.0.1:8319/v1/models",
                                     headers={"Authorization": "Bearer " + token})
        with urllib.request.urlopen(req, timeout=5) as response:
            return [row["id"] for row in json.load(response).get("data", []) if row.get("id")]
    except (OSError, ValueError, KeyError):
        return []


def cmd_models(cfg, args):
    """List core models, optionally filtered by account or text."""
    query = args[0].lower() if args else ""
    route = _route(cfg, args[0]) if args else None
    if route: query = ""
    models = [m for m in _core_models() if not query or query in m.lower()]
    if not models: die("no matching core models (is oms-core running?)")
    current = route.get("model") if route else None
    for model in models: print(("* " if model == current else "  ") + model)


def cmd_config(cfg, args):
    """Read every setting. `oms set` is the one place that writes them."""
    if args:
        die("`oms config` only shows settings. change them with:  oms set [<account>] key=value")
    print("global")
    for k in GLOBAL_KEYS:
        v = cfg.get(k)
        if k == "warn_at" and v is None:
            v = f"{min(cfg['block_at'], 95) - 10} (derived)"
        if k == "priority":
            v = ", ".join(v) if v else "auto"
        print(f"  {k:<15} {v if v is not None else '-'}")
    direct = {a["name"]: a for a in cfg["accounts"]}
    for name in _account_names(cfg):
        a, route = direct.get(name), _route(cfg, name)
        vendor = a["vendor"] if a else next((b.get("provider") for b in _core_bindings(cfg)
                                              if b.get("account") == name), "core")
        print(f"\n{name}  ({vendor})")
        for k in ACCOUNT_KEYS:
            if k == "name": continue
            v = (route or {}).get(k) if k in ("model", "effort") and route else a.get(k) if a else None
            if k == "args": v = " ".join(v) if v else None
            elif k == "paid_overflow" and v is not None: v = "yes" if v else "no"
            print(f"  {k:<15} {v if v is not None else '-'}")
        if route:
            print(f"  {'-> core route':<15} oms-core/{route.get('model') or '?'}"
                  f"{':' + route['effort'] if route.get('effort') else ''}")
        elif a:
            flags = launch_flags(a)
            print(f"  {'-> launches':<15} {a['vendor']} {' '.join(flags) if flags else '(defaults)'}")
    print("\n  oms models <account>         oms set <account> model=... effort=high")
    print("  oms set block_at=90          oms pi <account>")


def cmd_set(cfg, args):
    """The single writer: every setting, global or per account, as key=value."""
    if not args:
        die("usage: oms set [<account>] key=value ...\n"
            "  global:  " + "  ".join(GLOBAL_KEYS) + "\n"
            "  account: " + "  ".join(ACCOUNT_KEYS))
    targets, route_targets = None, None
    if "=" not in args[0]:
        name = args[0]
        if name == "all":
            targets = list(cfg["accounts"])
            route_targets = list((cfg.get("pi") or {}).get("routes", []))
        else:
            account, route = next((a for a in cfg["accounts"] if a["name"] == name), None), _route(cfg, name)
            if not account and not route:
                die(f"no such account: {name} (have: {', '.join(_account_names(cfg)) or 'none'})")
            targets, route_targets = ([account] if account else []), ([route] if route else [])
        args = args[1:]
    keys = ACCOUNT_KEYS if targets is not None else GLOBAL_KEYS
    for pair in args:
        if "=" not in pair:
            die(f"expected key=value, got {pair!r}")
        k, v = pair.split("=", 1)
        if k not in keys:
            die(f"unknown {'account' if targets else 'global'} key {k!r}."
                f" valid: {', '.join(keys)}")
        val = _coerce(k, v)
        if targets is None:
            cfg.pop(k, None) if val is None else cfg.update({k: val})
            continue
        if k in ("model", "effort") and route_targets:
            if k == "model" and val and (models := _core_models()) and val not in models:
                die(f"unknown core model {val!r}; run `oms models`")
            if k == "effort" and val and val not in ("off", "minimal", "low", "medium", "high", "xhigh", "max"):
                die(f"effort takes off, minimal, low, medium, high, xhigh, or max; got {val!r}")
            for route in route_targets:
                route.pop(k, None) if val is None else route.update({k: val})
        for a in targets:
            if k in ("model", "effort") and route_targets:
                continue
            if k in SETTING_KEYS and k not in provider(a)["flags"]:
                print(f"  skipped {a['name']}: {a['vendor']} has no {k} setting", file=sys.stderr)
                continue
            if k == "effort" and val and val not in provider(a)["efforts"]:
                die(f"{a['vendor']} takes effort {', '.join(provider(a)['efforts'])}; got {val!r}")
            if k == "name": cmd_rename(cfg, [a["name"], val])
            elif val is None: a.pop(k, None)
            else: a[k] = val
    save(cfg)
    cmd_config(cfg, [])


def cmd_run(cfg, args, check=True):
    if not args:
        die("usage: oms run [--force] <account> [cli args...]")
    a = find(cfg, args[0])
    if check:
        u = usage(a)
        if stale(u):
            print(f"oms: {a['name']} was last read {_ago(u['age'])} ago, so the guard is "
                  f"going on old information", file=sys.stderr)
        if u.get("err"):
            # unknown usage is not evidence of risk, and every fresh profile starts here
            print(f"oms: {a['name']} usage unknown ({u['err']})", file=sys.stderr)
        elif (b := blocked(a, u, cfg["block_at"])):
            die(f"{a['name']} blocked: {b}\n     'oms run --force {a['name']}' to override, "
                f"or 'oms auto {a['vendor']}' to pick another")
    extra = args[1:]
    if "--handoff" in extra:
        extra = [x for x in extra if x != "--handoff"] + [_handoff_prompt()]
    ensure_installed(a["vendor"])
    b = provider(a)["bin"]
    os.execvpe(b, [b, *launch_flags(a), *extra], env_for(a))


def rank(u, acct=None):
    """Sort by the next actual reset, then the smallest pool and lowest usage."""
    _, pct = u.get("soonest") or ("?", u.get("pct", 0))
    size = u.get("size") if u.get("size") is not None else (acct or {}).get("size")
    return (u.get("resets") or float("inf"),
            size if size is not None else float("inf"), pct)


def sel_key(cfg, acct, u):
    """Where this account sits in the pick order: explicit list first, else `rank`."""
    order = cfg.get("priority") or []
    if acct["name"] in order:
        return (0, order.index(acct["name"]))
    return (1, *rank(u, acct))


def cmd_priority(cfg, args):
    """Show or set an explicit account order for `oms auto`."""
    if args and args[0] in ("--auto", "auto", "reset"):
        cfg.pop("priority", None)
        save(cfg)
        print("priority: automatic (next reset first, then smallest pool)")
        return
    if args:
        for n in args:
            find(cfg, n)
        cfg["priority"] = list(args)
        save(cfg)
    order = cfg.get("priority")
    if not order:
        print("priority: automatic - next reset first, then smallest pool\n")
        # one width for the whole table, not one per vendor group
        w = max((len(a["name"]) for a in cfg["accounts"]), default=4)
        for v in sorted({a["vendor"] for a in cfg["accounts"]}):
            mine = [a for a in cfg["accounts"] if a["vendor"] == v]
            ranked = sorted(((sel_key(cfg, a, u), a, u)
                             for a, u in zip(mine, usage_all(mine)) if not u.get("err")),
                            key=lambda t: t[0])
            for i, (k, a, u) in enumerate(ranked, 1):
                _, used = u["soonest"]
                why = f"resets in {_until(u.get('resets'))}, {used:.0f}% used"
                sz = k[2] if len(k) > 2 else None
                if isinstance(sz, (int, float)) and sz != float("inf"):
                    why += f", pool {sz:g}"
                # the order and what it costs you belong on the same line: reading them
                # off two different commands is how the reserve gets burned by mistake
                bill = "can bill" if u["paid_on"] else "cannot bill"
                blk = blocked(a, u, cfg["block_at"])
                print(f"  {v:<7}{i}. {a['name']:<{w}}  {why:<38} {'BLOCKED' if blk else bill}")
        return
    print("priority: explicit\n  " + "\n  ".join(f"{i}. {n}" for i, n in enumerate(order, 1)))
    print("\n  'oms priority --auto' to go back to the automatic rule")


def cmd_auto(cfg, args):
    dry = "--dry-run" in args
    args = [a for a in args if a != "--dry-run"]
    if args and args[0] in PROVIDERS:
        vendor, rest = args[0], args[1:]
    else:
        # never guess: an unnamed provider used to default to claude and launch it,
        # so a typo started a session on an account nobody asked for
        have = sorted({a["vendor"] for a in cfg["accounts"]})
        if len(have) != 1:
            die(f"which provider? you have: {', '.join(have) or 'none'}\n"
                f"  oms auto <{'|'.join(have) or '|'.join(PROVIDERS)}> [args...]")
        vendor, rest = have[0], args
    mine = [a for a in cfg["accounts"] if a["vendor"] == vendor]
    usable = [(a, u) for a, u in zip(mine, usage_all(mine))
              if not u.get("err") and not blocked(a, u, cfg["block_at"])]
    # a fresh reading is evidence and a stale one is not, so prefer any fresh account -
    # but refusing to launch at all because nothing was measured recently is the worse
    # failure, and for a claude account, being unread is simply what between sessions
    # looks like
    fresh = [(sel_key(cfg, a, u), a, u) for a, u in usable if not stale(u)]
    cands = fresh or [(sel_key(cfg, a, u), a, u) for a, u in usable]
    if not cands:
        die(f"no {vendor} account is both known-good and unblocked. run 'oms status'")
    _, best, bu = min(cands, key=lambda t: t[0])
    why = bu.get("detail") or f"{bu['pct']:.0f}% used"
    if stale(bu):
        why += f", last read {_ago(bu['age'])} ago"
    if dry:
        print(f"{best['name']}  {why}\n$ {' '.join([provider(best)['bin'], *launch_flags(best), *rest])}")
        return
    print(f"oms: {best['name']} ({why})", file=sys.stderr)
    if "--handoff" in rest:
        rest = [x for x in rest if x != "--handoff"] + [_handoff_prompt()]
    b = PROVIDERS[vendor]["bin"]
    os.execvpe(b, [b, *launch_flags(best), *rest], env_for(best))


# --- status line rendering ---------------------------------------------------
# Two tiers. The session it is running goes on its own line; the accounts go below it
# in a grid whose columns line up, so a wrap reads as a table rather than as an
# accident. Green under 60%, amber above, and red only where continuing costs money.

BAR = 8
RESET, DIM, BOLD = "\033[0m", "\033[2m", "\033[1m"
GREEN, YELLOW, RED = "\033[32m", "\033[33m", "\033[31m"
GAP = "   "


def _tone(pct, is_blocked):
    """Red means money, and only money. A plan with no credit attached can sit at 99%
    without being a problem - it just stops - so a full bar there stays amber."""
    if is_blocked:
        return RED
    return YELLOW if pct >= 60 else GREEN


def _bar(pct, width, colour):
    """Heavy filled run against a light rule, so the bar reads without colour too."""
    filled = max(0, min(width, round(pct / 100 * width)))
    return f"{colour}{'▬' * filled}{RESET}{DIM}{'─' * (width - filled)}{RESET}"


def _meter(pct, blocked_, width=BAR):
    c = _tone(pct, blocked_)
    return f"{_bar(pct, width, c)} {c}{pct:>3.0f}%{RESET}"


def _tokens(n):
    if not n:
        return "?"
    return f"{n // 1000000}M" if n >= 1000000 else f"{n // 1000}K"


def _wide(t):
    return len(re.sub(r"\x1b\[[0-9;]*m", "", t))


def _pad(t, w):
    return t + " " * max(0, w - _wide(t))


def _mins(label):
    """Order columns shortest window first; unparsable labels sort last."""
    try:
        n, unit = int(label[:-1]), label[-1]
    except ValueError:
        return 10 ** 9
    return n * {"h": 60, "d": 1440}.get(unit, 10 ** 9)


def _session_line(d, width):
    """Model, effort and context headroom - the things that change under you mid-task."""
    mdl = (d.get("model") or {}).get("display_name") or (d.get("model") or {}).get("id")
    if not mdl:
        return None
    cw = d.get("context_window") or {}
    size = cw.get("context_window_size")
    # "Opus 5 (1M context)" states the window in the name and the ctx segment states it
    # again. Keep the segment, where the live number already is, and drop the parenthetical.
    if size:
        mdl = re.sub(r"\s*\([^)]*\)\s*$", "", mdl) or mdl
    left = f"{BOLD}{mdl}{RESET}"
    if (d.get("effort") or {}).get("level"):
        # three weights: model bold, effort plain, the rest dim
        left += f" {d['effort']['level']}"
    rem = cw.get("remaining_percentage")
    if rem is None and cw.get("used_percentage") is not None:
        rem = 100 - cw["used_percentage"]
    if rem is None:
        return left + (f"  {DIM}{_tokens(size)} context{RESET}" if size else "")
    c = RED if rem < 15 else (YELLOW if rem < 35 else GREEN)
    right = (f"{DIM}ctx{RESET} {_bar(rem, 10, c)} {c}{rem:.0f}% left{RESET}"
             + (f"{DIM} of {_tokens(size)}{RESET}" if size else ""))
    gap = max(2, width - _wide(left) - _wide(right))
    return left + " " * gap + right


def _table(rows, columns, max_rows=4):
    """One account per row; each window gets a column, shortest first.

    Every row starts with its name, never with padding. Claude Code strips leading
    whitespace from each status line, so a leading marker column survives only on the
    rows that have a marker and collapses on the rest, pulling them out of line. The
    marker goes after the name instead, inside the name field.

    The column a meter sits in says which window it is, so the 5h / 7d labels that were
    repeated against every account come out entirely. Cells are a fixed width, so the
    columns line up down the table however many accounts there are.
    """
    if not rows:
        return [], 0
    labels = sorted({l for _, _, w, _ in rows if not isinstance(w, str) for l in w},
                    key=_mins)
    name_w = max(_wide(n) + _wide(m) for m, n, _, _ in rows) + 1
    cell_w = BAR + 5
    extra = len(rows) - max_rows
    if extra > 0:
        rows = rows[:max_rows]
    out = []
    for mark, name, wins, blocked_ in rows:
        head = name + (f" {mark}" if mark.strip() else "")
        if isinstance(wins, str):  # an account with nothing to meter still gets a row
            out.append(f"{_pad(head, name_w)}  {DIM}{wins}{RESET}")
            continue
        cells = [_pad(_meter(wins[l], blocked_) if l in wins else "", cell_w) for l in labels]
        out.append(f"{_pad(head, name_w)}  " + " ".join(cells).rstrip())
    if extra > 0:
        out[-1] = f"{DIM}+{extra} more account{'s' if extra > 1 else ''}{RESET}"
    return out, name_w + 2 + len(labels) * (cell_w + 1) - 1


def cmd_statusline(cfg, args):
    """Claude Code statusLine command: record this account's rate_limits, draw the strip.

    Any extra args are run as your previous status line and its output is passed through.
    """
    try:
        _statusline(cfg, args)
    except Exception as e:
        # this renders inside Claude Code on every frame; a traceback in the status bar
        # helps nobody, and a broken reading is not worth losing the whole strip over
        print(f"{DIM}oms unavailable ({type(e).__name__}){RESET}")


def _statusline(cfg, args):
    raw = sys.stdin.read()
    try:
        d = json.loads(raw)
    except ValueError:
        d = {}
    name = os.environ.get("OMS_ACCOUNT")
    if not name:  # not launched through oms: match the running config dir to an account
        cur = Path(os.environ.get("CLAUDE_CONFIG_DIR") or DEFAULT_CLAUDE_DIR)
        for a in cfg["accounts"]:
            if a["vendor"] == "claude" and Path(a["dir"]) == cur:
                name = a["name"]
    if name and d.get("rate_limits"):
        write_json(USAGE / f"{name}.json", {"at": time.time(),
                                            "rate_limits": d["rate_limits"]})
    if args:  # chain to whatever status line you had
        p = subprocess.run(args, input=raw, capture_output=True, text=True)
        sys.stdout.write(p.stdout)
        return

    here = cfg_find_self(cfg, name)
    rl = d.get("rate_limits") or {}
    live = {l: (rl.get(k) or {}).get("used_percentage") or 0
            for k, l in (("five_hour", "5h"), ("seven_day", "7d")) if rl.get(k)}

    rows = []
    if live:  # the running session is authoritative for its own account
        limit = (here or {}).get("block_at", cfg["block_at"])
        paid = (here or {}).get("paid_overflow", True)
        bad = paid and max(live.values()) >= limit
        rows.append((f"{RED}!{RESET}" if bad else "",
                     f"{BOLD}{GREEN}{name or 'claude'}{RESET}", live, bad))
    others = [a for a in cfg["accounts"] if a["name"] != name]
    rest = [(a["vendor"] != (here or {}).get("vendor"), a["vendor"],
             sel_key(cfg, a, u) if not u.get("err") else (9,), a, u)
            for a, u in zip(others, usage_all(others))]
    for *_, a, u in sorted(rest, key=lambda t: t[:3]):
        nm = f"{DIM}{a['name']}{RESET}"
        if u.get("err") or not u.get("windows"):
            rows.append(("", nm, u.get("err", "no windows"), False))
            continue
        b = bool(blocked(a, u, cfg["block_at"]))
        rows.append((f"{RED}!{RESET}" if b else "", nm, dict(u["windows"]), b))

    body, width = _table(rows, int(os.environ.get("COLUMNS") or 80))
    head = _session_line(d, width)
    for line in ([head] if head else []) + body:
        print(line)


def cfg_find_self(cfg, name):
    for a in cfg["accounts"]:
        if a["name"] == name:
            return a
    return None


def cmd_install(cfg, args):
    """Wire `oms statusline` into settings.json, chaining any existing status line."""
    s = DEFAULT_CLAUDE_DIR / "settings.json"
    d = json.loads(s.read_text()) if s.exists() else {}
    prev = d.get("statusLine")
    me = str(Path(__file__).resolve())
    if isinstance(prev, dict) and "oms statusline" in str(prev.get("command", "")):
        print("already installed")
        return
    cmd = f"{me} statusline"
    if isinstance(prev, dict) and prev.get("command"):
        cmd += " " + prev["command"]
        print(f"chaining your existing status line: {prev['command']}")
    d["statusLine"] = {"type": "command", "command": cmd}
    s.write_text(json.dumps(d, indent=2))
    print(f"installed into {s}\nrestart claude, then 'oms status' will see this account's usage.")


def cmd_login(cfg, args):
    """Log in to a new account first, name it after. `oms login codex`"""
    allow = "--no-install" not in args
    do_prime = "--no-prime" not in args
    args = [a for a in args if a not in ("--no-install", "--no-prime")]
    if not args or args[0] not in PROVIDERS:
        die(f"usage: oms login <{'|'.join(PROVIDERS)}> [<name>]"
            " [--no-install] [--no-prime]")
    vendor = args[0]
    want = args[1] if len(args) > 1 else None
    existing = next((a for a in cfg["accounts"] if a["name"] == want), None)
    if existing and existing["vendor"] != vendor:
        die(f"{want} is a {existing['vendor']} account, not {vendor}")
    # log in straight into the account being adopted, so nothing has to move afterwards
    tmp = Path(existing["dir"]) if existing else OMS / "pending" / f"{vendor}-{int(time.time())}"
    tmp.mkdir(parents=True, exist_ok=True)
    e = dict(os.environ)
    for k in ("OPENAI_API_KEY", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"):
        e.pop(k, None)
    e[PROVIDERS[vendor]["home"]] = str(tmp)
    p = PROVIDERS[vendor]
    warn_shared_auth(cfg, vendor, want)
    ensure_installed(vendor, allow)
    if vendor == "claude":
        for sh in SHARED:  # so the login session looks like your normal setup
            src = DEFAULT_CLAUDE_DIR / sh
            if src.exists():
                (tmp / sh).symlink_to(src)
    cmd = [p["bin"], *(p["login"] or p["launch"])]
    if p["login"] is None:
        print(f"launching {p['bin']} - run /login inside it, then exit with Ctrl-D")
    if subprocess.run(cmd, env=e).returncode != 0:
        die(f"login failed; nothing registered. profile left at {tmp}")
    if existing:
        print(f"logged in as {existing['name']}")
        prime(existing, do_prime)
        return
    taken = {a["name"] for a in cfg["accounts"]}
    default = want or next(f"{vendor}-{i}" for i in range(2, 99) if f"{vendor}-{i}" not in taken)
    if want:
        name = want
    elif sys.stdin.isatty():
        try:
            name = input(f"name this account [{default}]: ").strip() or default
        except EOFError:
            name = default
    elif True:
        # No terminal to ask on, so don't pretend to: take the default and say so loudly.
        name = default
        print(f"\n  no terminal to prompt on, so this is registered as '{name}'."
              f"\n  rename it with:  oms rename {name} <your-name>\n")
    if name in taken:
        die(f"'{name}' is already registered. pick another, profile is at {tmp}")
    dest = OMS / "accounts" / name
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists() and dest != tmp:
        # a profile under this name that no account claims - an earlier login that was
        # interrupted after signing in and before registering. Renaming onto it fails,
        # and doing so here would be a traceback handed to someone who has just finished
        # a browser flow, with the fresh login left somewhere they were never told about.
        die(f"there is already a profile at {dest} that no account is using.\n"
            f"  your new login is safe at {tmp}\n"
            f"  either pick another name, or remove that directory and run this again")
    if dest != tmp:
        tmp.rename(dest)
    acct = {"name": name, "vendor": vendor, "dir": str(dest)}
    if vendor == "claude":
        acct["paid_overflow"] = True
    cfg["accounts"].append(acct)
    save(cfg)
    print(f"registered {name} -> {dest}")
    prime(acct, do_prime)
    if vendor == "claude":
        print("set 'paid_overflow': false in ~/.oms/config.json if this plan has no credit attached")


def cmd_rename(cfg, args):
    """Rename an account, carrying its recorded usage with it."""
    if len(args) != 2:
        die("usage: oms rename <old> <new>")
    old, new = args
    a = find(cfg, old)
    if any(x["name"] == new for x in cfg["accounts"]):
        die(f"'{new}' is already registered")
    for suffix in (".json", ".cache.json", ".warned.json", ".trail.jsonl",
                   ".codex-cache.json"):
        src = USAGE / f"{old}{suffix}"
        if src.exists():
            src.rename(USAGE / f"{new}{suffix}")
    d = Path(a["dir"])
    if d.parent == OMS / "accounts" and d.name == old:  # a profile oms created
        d.rename(d.parent / new)
        a["dir"] = str(d.parent / new)
    a["name"] = new
    # the pick order names accounts too; leaving the old one there drops this account
    # out of an explicit order without saying so
    if cfg.get("priority"):
        cfg["priority"] = [new if n == old else n for n in cfg["priority"]]
    save(cfg)
    print(f"{old} -> {new}")


def prime(acct, run=True):
    """Spend one trivial turn so the account reports usage straight away.

    Every provider only records usage once it has actually done something, so a freshly
    registered account reads "no data yet" and `oms auto` skips it until you happen to
    use it. One turn costs a rounding error and makes it visible immediately.
    """
    cmd = provider(acct).get("prime")
    if not run or not cmd:
        return
    print(f"priming {acct['name']} with one turn so it reports usage...")
    b = provider(acct)["bin"]
    r = subprocess.run([b, *launch_flags(acct), *cmd], env=env_for(acct),
                       capture_output=True, text=True)
    if r.returncode != 0:
        print(f"  could not prime ({(r.stderr or '').strip()[:80]}) - it will fill in "
              f"the first time you use the account", file=sys.stderr)
        return
    u = usage(acct)
    print(f"  {acct['name']}: {u['detail'] if not u.get('err') else u['err']}")


def cmd_remove(cfg, args):
    """Unregister an account. Its profile directory is kept unless you say otherwise."""
    purge = "--purge" in args
    args = [a for a in args if a != "--purge"]
    if not args:
        die("usage: oms remove <name> [--purge]   (--purge also deletes the profile)")
    a = find(cfg, args[0])
    cfg["accounts"] = [x for x in cfg["accounts"] if x["name"] != a["name"]]
    for suffix in (".json", ".cache.json", ".warned.json", ".trail.jsonl",
                   ".codex-cache.json"):
        (USAGE / f"{a['name']}{suffix}").unlink(missing_ok=True)
    if cfg.get("priority"):
        cfg["priority"] = [n for n in cfg["priority"] if n != a["name"]] or None
        if cfg["priority"] is None:
            cfg.pop("priority")
    save(cfg)
    d = Path(a["dir"])
    if purge and d.parent == OMS / "accounts":  # only ever delete a profile oms created
        __import__("shutil").rmtree(d, ignore_errors=True)
        print(f"removed {a['name']} and deleted {d}")
    else:
        print(f"removed {a['name']}" + (f"  (profile left at {d})" if d.exists() else ""))
        if purge:
            print("  not deleted: oms did not create that directory")


def cmd_doctor(cfg, args):
    """Check that the parts which fail silently are still connected.

    Most of this tool is wiring into other programs - a status line path in someone
    else's settings, a hook in a plugin, a CLI per provider - and every one of them
    fails quietly by design, because a status line must not throw and a hook must not
    stand in the way. Quiet failure needs somewhere loud to ask.
    """
    ok = True

    def say(good, label, detail=""):
        nonlocal ok
        ok = ok and good
        print(f"  {'ok  ' if good else 'FAIL'}  {label:<22} {detail}")

    me = Path(__file__).resolve()
    say(True, "oms", str(me))
    from shutil import which
    on_path = which("oms")
    say(bool(on_path), "on PATH", on_path or "not on PATH - `oms` will not resolve in a subshell")

    line = ((json.loads((DEFAULT_CLAUDE_DIR / "settings.json").read_text())
             if (DEFAULT_CLAUDE_DIR / "settings.json").exists() else {}).get("statusLine") or {})
    cmd = (line.get("command") or "").split()
    if not cmd:
        say(True, "status line", "not installed (only needed for a claude account)")
    else:
        there = Path(cmd[0]).exists()
        say(there, "status line", cmd[0] if there else f"{cmd[0]} is gone - run `oms install`")

    for a in cfg["accounts"]:
        u = usage(a)
        if not installed(a["vendor"]):
            say(False, a["name"], f"{provider(a)['bin']} not installed - `oms login {a['vendor']}`")
        elif u.get("err"):
            say(False, a["name"], u["err"])
        else:
            b = blocked(a, u, cfg["block_at"])
            say(True, a["name"], f"{u['detail']}{'  BLOCKED: ' + b if b else ''}")
    if not cfg["accounts"]:
        say(False, "accounts", f"none yet - `oms login <{'|'.join(PROVIDERS)}>`")

    print("\neverything reachable" if ok else "\nsomething above needs fixing")
    sys.exit(0 if ok else 1)


def cmd_env(cfg, args):
    a = find(cfg, args[0])
    print(f'export {provider(a)["home"]}="{a["dir"]}"')


def _bind_core_account(cfg, account_name, row):
    bindings = [b for b in _core_bindings(cfg) if b.get("account") != account_name]
    bindings.append({"account": account_name, "core_id": row["auth_index"],
                     "provider": row.get("provider"), "paid_overflow": True})
    cfg["core"] = {**(cfg.get("core") or {}), "bindings": bindings}
    defaults = {"codex": "gpt-5.6-sol", "claude": "claude-sonnet-4-6",
                "antigravity": "gemini-pro-agent"}
    routes = [r for r in (cfg.get("pi") or {}).get("routes", []) if r.get("account") != account_name]
    previous = next((r for r in (cfg.get("pi") or {}).get("routes", []) if r.get("account") == account_name), {})
    routes.append({"account": account_name, "coreAccount": row["auth_index"],
                   "provider": "oms-core", "model": previous.get("model") or defaults.get(row.get("provider"), "")})
    cfg["pi"] = {**(cfg.get("pi") or {}), "accountBindingsConfirmed": True, "routes": routes}


def cmd_pi(cfg, args):
    """Launch Pi pinned to one mapped OMS account."""
    if not args:
        die("usage: oms pi <account|gemini> [pi args...]")
    name = args[0]
    routes = [r for r in (cfg.get("pi") or {}).get("routes", []) if r.get("provider") == "oms-core"]
    if name in ("gemini", "google"):
        matches = [r for r in routes if str(r.get("model", "")).startswith("gemini")]
        if len(matches) != 1: die("gemini alias requires exactly one mapped Gemini account")
        route = matches[0]
    else:
        route = next((r for r in routes if r.get("account") == name), None)
    if not route or not route.get("model"):
        die(f"no oms-core Pi route configured for {name}")
    env = dict(os.environ)
    env["OMS_ACCOUNT"] = route["account"]
    command = ["pi", "--model", f"oms-core/{route['model']}"]
    if route.get("effort"): command += ["--thinking", route["effort"]]
    command += args[1:]
    os.execvpe(command[0], command, env)


def cmd_core(cfg, args):
    """Manage the shared OMS provider sidecar; provider OAuth remains core-owned."""
    import signal
    root = OMS / "core"
    binary, config = OMS / "bin" / "oms-core", root / "config.yaml"
    facade, management = root / "facade.token", root / "management.token"
    pid_file, log_file = root / "oms-core.pid", root / "oms-core.log"
    action = args[0] if args else "status"
    try:
        pid = int(pid_file.read_text())
        running = pid > 0 and (os.kill(pid, 0) is None)
    except (OSError, ValueError):
        pid, running = None, False
    if action == "install":
        import hashlib, platform, secrets, urllib.request
        system = {"Darwin": "darwin", "Linux": "linux"}.get(platform.system())
        arch = {"arm64": "arm64", "aarch64": "arm64", "x86_64": "amd64", "AMD64": "amd64"}.get(platform.machine())
        if not system or not arch: die(f"core is not available for {platform.system()} {platform.machine()}")
        asset = f"oms-core-{system}-{arch}"
        base = os.environ.get("OMS_CORE_RELEASE_BASE") or \
            f"https://github.com/goosull/oh-my-subscriptions/releases/download/v{CORE_RELEASE}"
        try:
            payload = urllib.request.urlopen(base.rstrip("/") + "/" + asset, timeout=120).read()
            checksum = urllib.request.urlopen(base.rstrip("/") + "/" + asset + ".sha256", timeout=30).read().decode().split()[0]
        except Exception as error:
            die(f"core download failed ({error})")
        if hashlib.sha256(payload).hexdigest() != checksum: die("core checksum verification failed")
        binary.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        tmp = binary.with_name("." + binary.name + f".{os.getpid()}")
        tmp.write_bytes(payload); os.chmod(tmp, 0o700); tmp.replace(binary)
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        for token_file in (facade, management, root / "service.token"):
            if not token_file.exists():
                token_file.write_text(secrets.token_urlsafe(48) + "\n"); os.chmod(token_file, 0o600)
        if not config.exists():
            config.write_text("\n".join([
                "host: 127.0.0.1", "port: 8320", f'auth-dir: "{root / "auth"}"',
                "api-keys:", f'  - "{(root / "service.token").read_text().strip()}"',
                "remote-management:", "  allow-remote: false",
                f'  secret-key: "{management.read_text().strip()}"', "  disable-control-panel: true",
                "plugins:", "  enabled: false", "debug: false", "",
            ])); os.chmod(config, 0o600)
        (root / "auth").mkdir(parents=True, exist_ok=True, mode=0o700)
        print(f"core {CORE_RELEASE} installed for {system}-{arch}")
        cmd_core(cfg, ["start"])
        return
    if action == "status":
        print(f"core: {'running' if running else 'stopped'}" + (f" (pid {pid})" if running else ""))
        return
    if action == "login":
        if not running: die("core is stopped; run `oms core start`")
        if len(args) not in (2, 3): die("usage: oms core login <claude|codex|google> [oms-account]")
        endpoint = {"claude": "anthropic-auth-url", "codex": "codex-auth-url",
                    "google": "antigravity-auth-url", "gemini": "antigravity-auth-url"}.get(args[1])
        if not endpoint: die("core login supports: claude, codex, google")
        import urllib.request, urllib.parse, webbrowser
        token = management.read_text().strip()
        def request(path):
            req = urllib.request.Request("http://127.0.0.1:8320/v0/management/" + path,
                                         headers={"Authorization": "Bearer " + token})
            with urllib.request.urlopen(req, timeout=15) as response:
                return json.load(response)
        before = {row.get("auth_index") for row in request("auth-files").get("files", [])}
        result = request(endpoint + "?is_webui=true")
        if result.get("status") != "ok" or not result.get("url") or not result.get("state"):
            die("core did not start the OAuth flow")
        webbrowser.open(result["url"])
        print(f"complete {args[1]} login in the browser...")
        state = urllib.parse.quote(result["state"], safe="")
        for _ in range(600):
            try: current = request("get-auth-status?state=" + state)
            except Exception: die(f"{args[1]} login interrupted; retry after core is stable")
            if current.get("status") == "ok":
                time.sleep(.5)
                rows = request("auth-files").get("files", [])
                created = [row for row in rows if row.get("auth_index") not in before]
                account_name = args[2] if len(args) == 3 else None
                provider_name = "antigravity" if args[1] in ("google", "gemini") else args[1]
                if account_name:
                    account = find(cfg, account_name) if provider_name != "antigravity" else None
                    if account and account["vendor"] != provider_name: die(f"{account_name} is not a {provider_name} account")
                else:
                    bound = {b.get("account") for b in _core_bindings(cfg)}
                    candidates = [a["name"] for a in cfg["accounts"]
                                  if a["vendor"] == provider_name and a["name"] not in bound]
                    if provider_name == "antigravity" and len(created) == 1: candidates = ["google-work"]
                    if len(candidates) == 1: account_name = candidates[0]
                if account_name and len(created) == 1:
                    _bind_core_account(cfg, account_name, created[0])
                    save(cfg)
                    print(f"{args[1]} login complete -> {account_name}")
                else:
                    print(f"{args[1]} login complete; credential left unmapped and disabled")
                cmd_core(cfg, ["sync"])
                return
            if current.get("status") == "error":
                die(f"{args[1]} login failed: {current.get('error', 'unknown error')}")
            time.sleep(.5)
        die(f"{args[1]} login timed out")
    if action == "sync":
        if not running: die("core is stopped; run `oms core start`")
        import urllib.request
        management_token = management.read_text().strip()
        def api(path, method="GET", payload=None):
            data = json.dumps(payload).encode() if payload is not None else None
            headers = {"Authorization": "Bearer " + management_token}
            if data is not None: headers["Content-Type"] = "application/json"
            req = urllib.request.Request("http://127.0.0.1:8320/v0/management/" + path,
                                         data=data, method=method, headers=headers)
            with urllib.request.urlopen(req, timeout=15) as response: return json.load(response)
        rows = api("auth-files").get("files", [])
        bindings = {(b.get("core_id") or ""): b for b in (cfg.get("core") or {}).get("bindings", [])}
        readings = {a["name"]: (a, u) for a, u in zip(cfg["accounts"], usage_all(cfg["accounts"]))}
        def refresh_core_quota(row, binding):
            if row.get("provider") != "antigravity" or not row.get("project_id"): return
            payload = {"auth_index": row.get("auth_index"), "method": "POST",
                       "url": "https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary",
                       "header": {"Authorization": "Bearer $TOKEN$", "Content-Type": "application/json",
                                  "User-Agent": "antigravity/hub/2.8.0 (aidev_client; os_type=darwin; arch=arm64; cl=963137146)"},
                       "data": json.dumps({"project": row["project_id"]})}
            try:
                result = api("api-call", "POST", payload)
                if result.get("status_code") != 200: return
                quota = json.loads(result.get("body") or "{}")
                windows = []
                resets = []
                for group in quota.get("groups") or []:
                    for bucket in group.get("buckets") or []:
                        if bucket.get("disabled") is True or bucket.get("remainingFraction") is None: continue
                        source = f"{bucket.get('window', '')} {bucket.get('bucketId', '')} {bucket.get('displayName', '')}".lower()
                        label = "7d" if "week" in source else "5h" if "5h" in source else "24h"
                        used = max(0, min(100, (1 - float(bucket["remainingFraction"])) * 100))
                        reset = None
                        if bucket.get("resetTime"):
                            import datetime as dt
                            reset = dt.datetime.fromisoformat(bucket["resetTime"].replace("Z", "+00:00")).timestamp()
                            resets.append((used, reset))
                        windows.append({"window": label, "used_percent": used})
                if windows:
                    core_id = re.sub(r"[^A-Za-z0-9_-]", "_", str(binding["core_id"]))
                    write_json(USAGE / f"core-{core_id}.json",
                               {"at": time.time(), "provider": row.get("provider"), "windows": windows,
                                "resets_at": max(resets, default=(0, None))[1]})
            except (OSError, ValueError, KeyError):
                pass
        enabled = disabled = 0
        for row in rows:
            binding = bindings.get(row.get("auth_index") or "")
            pair = readings.get((binding or {}).get("account"))
            # `disabled` is also the state this sync writes for unsafe accounts; treating
            # it as fresh provider evidence makes that decision impossible to recover.
            runtime_blocked = bool(row.get("unavailable") or row.get("status") == "error")
            if binding and runtime_blocked:
                core_id = re.sub(r"[^A-Za-z0-9_-]", "_", str(binding["core_id"]))
                message = str(row.get("status_message") or "provider cooldown/unavailable")
                write_json(USAGE / f"core-{core_id}.json",
                           {"at": time.time(), "provider": row.get("provider"),
                            "error": "core unavailable: " + message[:300]})
                safe = False
            elif binding and not pair:
                refresh_core_quota(row, binding)
                u = _core_usage(binding)
                synthetic = {"name": binding["account"], "paid_overflow": bool(binding.get("paid_overflow"))}
                safe = not u.get("err") and not stale(u) and not blocked(synthetic, u, cfg["block_at"])
            elif binding and row.get("provider") == "antigravity" and pair[1].get("err"):
                refresh_core_quota(row, binding)
                u = _core_usage(binding)
                synthetic = {"name": binding["account"], "paid_overflow": bool(binding.get("paid_overflow"))}
                safe = not u.get("err") and not stale(u) and not blocked(synthetic, u, cfg["block_at"])
            else:
                safe = bool(pair and not pair[1].get("err") and not stale(pair[1]) and
                            not blocked(pair[0], pair[1], cfg["block_at"]))
            # Claude has no out-of-session quota endpoint. Once the reported reset time
            # passes, the old percentage is history; allow a guarded probe to refresh it.
            if binding and row.get("provider") == "claude" and pair and pair[1].get("resets") and \
                    float(pair[1]["resets"]) <= time.time():
                safe = True
            should_disable = not safe
            if bool(row.get("disabled")) != should_disable:
                api("auth-files/status", "PATCH", {"name": row.get("name"),
                                                     "auth_index": row.get("auth_index"),
                                                     "disabled": should_disable})
            if should_disable: disabled += 1
            else: enabled += 1
        print(f"core policy synced: {enabled} enabled, {disabled} disabled")
        return
    if action == "run":
        if not running: die("core is stopped; run `oms core start`")
        if len(args) < 3 or args[1] not in ("claude", "codex"):
            die("usage: oms core run <claude|codex> <oms-account> [agent args...]")
        host, account_name = args[1], args[2]
        route = next((r for r in (cfg.get("pi") or {}).get("routes", [])
                      if r.get("provider") == "oms-core" and r.get("account") == account_name), None)
        if not route or not route.get("model"):
            die(f"no oms-core route configured for {account_name}")
        import urllib.request
        body = json.dumps({"account": route.get("coreAccount") or account_name,
                           "model": route["model"]}).encode()
        req = urllib.request.Request("http://127.0.0.1:8319/v1/oms/account", data=body, method="PUT",
                                     headers={"Authorization": "Bearer " + facade.read_text().strip(),
                                              "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=10): pass
        except Exception as error:
            die(f"core account selection failed ({error})")
        env = dict(os.environ)
        token = facade.read_text().strip()
        if host == "claude":
            for key in ("ANTHROPIC_API_KEY",): env.pop(key, None)
            env["ANTHROPIC_BASE_URL"] = "http://127.0.0.1:8319"
            env["ANTHROPIC_AUTH_TOKEN"] = token
            command = ["claude", "--model", route["model"]]
            if route.get("effort"): command += ["--effort", route["effort"]]
            command += args[3:]
        else:
            env["OMS_CORE_TOKEN"] = token
            command = ["codex", '-c', 'model_provider="oms"',
                       '-c', 'model_providers.oms.name="OMS"',
                       '-c', 'model_providers.oms.base_url="http://127.0.0.1:8319/v1"',
                       '-c', 'model_providers.oms.env_key="OMS_CORE_TOKEN"',
                       '-c', 'model_providers.oms.wire_api="responses"',
                       '-m', route["model"]]
            if route.get("effort"): command += ['-c', f'model_reasoning_effort="{route["effort"]}"']
            command += args[3:]
        os.execvpe(command[0], command, env)
    if action == "stop":
        if running:
            os.kill(pid, signal.SIGTERM)
            for _ in range(50):
                try: os.kill(pid, 0)
                except OSError: break
                time.sleep(.1)
        pid_file.unlink(missing_ok=True)
        print("core stopped")
        return
    if action != "start":
        die("usage: oms core [install|start|stop|status|login <provider> [account]|sync|run <agent> <account>]")
    if running:
        print(f"core already running (pid {pid})")
        return
    for path in (binary, config, facade, management):
        if not path.is_file(): die(f"core is not installed ({path} missing)")
    env = dict(os.environ)
    env["OMS_CORE_TOKEN"] = facade.read_text().strip()
    env["OMS_CORE_MANAGEMENT_TOKEN"] = management.read_text().strip()
    with log_file.open("a") as log:
        process = subprocess.Popen([str(binary), "--config", str(config), "--listen", "127.0.0.1:8319"],
                                   stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                   start_new_session=True, env=env)
    write_json(pid_file, process.pid)
    # write_json adds JSON; an integer is still valid for int(read_text()).
    os.chmod(pid_file, 0o600)
    time.sleep(.2)
    if process.poll() is not None: die(f"core failed to start; see {log_file}")
    print(f"core started (pid {process.pid})")


def selftest():
    a = {"name": "x"}
    assert blocked(a, {"pct": 99, "paid_on": False}, 95) is None, "plan-only can't bill, never block"
    assert blocked(a, {"pct": 99, "paid_on": True}, 95), "must block possible overage"
    assert blocked(a, {"pct": 50, "paid_on": True}, 95) is None
    assert blocked({"name": "x", "block_at": 40}, {"pct": 50, "paid_on": True}, 95), "per-account limit"
    assert blocked(a, {"err": "nope"}, 95) == "nope", "unknown surfaces as a reason"
    # a reading old enough that the window could have moved is not evidence of anything
    fresh = reading([("5h", 30)], paid_on=True, age=60)
    old = reading([("5h", 30)], paid_on=True, age=3 * 86400)
    assert not stale(fresh) and stale(old)
    # staleness must not be laundered into a refusal: it stops auto choosing, not you running
    assert not blocked(a, old, 95), "an old reading is not itself a reason to refuse a launch"
    assert not stale(reading([("30d", 30)], age=3 * 86400)), "three days is young for a month"
    assert _win(10080) == "7d" and _win(300) == "5h" and _win(None) == "?"
    assert _until(time.time() + 7260).startswith("2h") and _until(0) == "-"
    assert _until(time.time() - 5) == "now"
    now = time.time()
    early = reading([("7d", 90)], resets=now + 3600)
    late = reading([("5h", 0)], resets=now + 7200)
    assert rank(early) < rank(late), "the next actual reset wins, regardless of cadence"
    assert rank(reading([("5h", 10)], resets=now)) < \
        rank(reading([("5h", 80)], resets=now))
    # same reset time: the smaller pool is spent first, and an unstated size sorts last
    assert rank(early, {"size": 100}) < rank(early, {"size": 5000}) < rank(early, {})
    assert rank(reading([("5h", 99)], resets=now), {"size": 9}) < rank(early, {"size": 1})
    two = reading([("5h", 10), ("7d", 90)], resets=now)
    assert rank(two)[-1] == 10, "usage tie-breaker reads the soonest window"
    cfg_ = {"priority": ["b"], "accounts": []}
    assert sel_key(cfg_, {"name": "b"}, reading([("7d", 99)])) < \
        sel_key(cfg_, {"name": "a"}, reading([("7d", 0)])), \
        "an explicitly listed account outranks any unlisted one"
    assert _wide(_meter(8, False)) == _wide(_meter(80, False)), \
        "a one-digit and a two-digit reading must occupy the same width, or columns jitter"
    assert _wide(f"{RED}abc{RESET}") == 3, "width must ignore colour escapes"
    assert _tokens(1000000) == "1M" and _tokens(200000) == "200K" and _tokens(None) == "?"
    c = _session_line({"model": {"display_name": "Opus"}, "effort": {"level": "high"},
                       "context_window": {"context_window_size": 1000000,
                                          "used_percentage": 34}}, 60)
    assert "Opus" in c and "high" in c and "1M" in c and "66% left" in c
    # the window is stated once: in the ctx segment, not also in the model name
    sl = _session_line({"model": {"display_name": "Opus 5 (1M context)"},
                        "context_window": {"context_window_size": 1000000,
                                           "used_percentage": 34}}, 60)
    assert "of 1M" in sl and "(1M context)" not in sl
    # a model that takes no effort, and a session before its first API call
    assert "Opus" in _session_line({"model": {"display_name": "Opus"}}, 60)
    assert _session_line({}, 60) is None
    assert _mins("5h") < _mins("7d") < _mins("zz"), "columns run shortest window first"
    _pace_reads_the_trail()
    r = reading([("5h", 12), ("7d", 40)], plan="pro", paid_on=True)
    assert r["binding"] == ["7d", 40] and r["pct"] == 40, "the headline is the fullest"
    assert r["soonest"] == ["5h", 12], "the order runs on the one that resets first"
    assert reading([("30d", 5)])["soonest"] == ["30d", 5]
    assert reading([])["pct"] == 0 and reading([])["windows"] == []
    assert set(reading([("7d", 1)])) == set(reading([("5h", 1)], size=9)) - {"size"}, \
        "every reading carries the same fields whoever produced it"
    # monthly periods must roll over the end of a month, and of a year
    import datetime as _dt
    for _day in (1, 15, 28):
        _s = _dt.datetime.fromisoformat(_period_start(_day).replace("Z", "+00:00"))
        _e = _dt.datetime.fromtimestamp(_period_end(_day), _dt.timezone.utc)
        assert _s.day == _day and _e.day == _day, "a period must start and end on its day"
        assert _s <= _dt.datetime.now(_dt.timezone.utc) < _e, "today must fall inside it"
        assert 27 <= (_e - _s).days <= 32, f"a month, not {(_e - _s).days} days"
    assert _coerce("usage_display", "status") == "status"
    assert _coerce("usage_widget", "no") is False
    assert _coerce("pi_auto", "yes") is True
    assert _coerce("usage_refresh_seconds", "60") == 60
    assert _coerce("block_at", "90") == 90 and _coerce("paid_overflow", "no") is False
    assert _coerce("args", "--model opus") == ["--model", "opus"]
    assert _coerce("args", "") is None and _coerce("priority", "auto") is None
    # an empty value clears any key, including the numeric ones
    assert all(_coerce(k, "") is None for k in
               ("block_at", "warn_at", "size", "context", "resets_on", "model", "effort"))
    assert _coerce("priority", "a, b") == ["a", "b"]
    # writes land whole or not at all, and leave no debris behind
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        t = Path(d) / "sub" / "x.json"
        write_json(t, {"a": 1})
        assert json.loads(t.read_text()) == {"a": 1}
        assert [f.name for f in t.parent.iterdir()] == ["x.json"]
    # json.dumps writes bare Infinity, which no other language's parser accepts
    assert "Infinity" not in json.dumps([None if k == float("inf") else k
                                         for k in sel_key({}, {"name": "x"}, reading([]))])
    # one setting, each vendor's own spelling
    assert launch_flags({"vendor": "claude", "effort": "high"}) == ["--effort", "high"]
    assert launch_flags({"vendor": "codex", "effort": "high"}) == \
        ["-c", 'model_reasoning_effort="high"']
    assert launch_flags({"vendor": "codex", "model": "gpt-5.3-codex"}) == ["-m", "gpt-5.3-codex"]
    assert launch_flags({"vendor": "claude", "context": 500}) == [], \
        "a setting the provider has no flag for must not leak into its argv"
    assert launch_flags({"vendor": "codex", "model": "m", "args": ["--raw"]})[-1] == "--raw"
    assert launch_flags({"vendor": "kiro"})[0] == "chat", "a provider may need a subcommand"
    core_cfg = {"accounts": [], "pi": {"routes": []}}
    _bind_core_account(core_cfg, "work", {"auth_index": "core-id", "provider": "codex"})
    assert core_cfg["core"]["bindings"][0]["account"] == "work"
    assert core_cfg["pi"]["routes"][0] == {"account": "work", "coreAccount": "core-id",
                                                   "provider": "oms-core", "model": "gpt-5.6-sol"}
    assert all({"bin", "home", "install", "launch", "prime", "usage", "flags", "efforts",
                "shared_auth"} <= set(v)
               for v in PROVIDERS.values()), "every provider must fill the whole table"
    assert all(isinstance(c, list) and c for v in PROVIDERS.values() for _, c in v["install"]), \
        "an install route must be a runnable argv, not prose to read"
    assert usage({"vendor": "kiro", "name": "k"})["err"], \
        "a provider with no usage surface must say so, not look like an empty account"
    mk = lambda n, w: (" ", n, w, False)
    body, _ = _table([mk("a", {"5h": 10, "7d": 20}), mk("b", {"7d": 30})], 80)
    # a missing window leaves its column empty rather than shifting the next one into it
    plain = [re.sub(r"\x1b\[[0-9;]*m", "", b) for b in body]
    assert plain[1].index("30%") == plain[0].index("20%")
    marked, _ = _table([("!", "a", {"7d": 1}, True), ("", "bbbb", {"7d": 2}, False)], 80)
    marked_plain = [re.sub(r"\x1b\[[0-9;]*m", "", b) for b in marked]
    assert marked_plain[0].index("1%") == marked_plain[1].index("2%"), \
        "a marker must not shift its row"
    assert not any(b.startswith(" ") for b in marked_plain), \
        "no row may lead with whitespace: Claude Code strips it and the row slides left"
    assert all(ord(ch) < 128 for b in marked_plain for ch in b if ch not in "▬─"), \
        "only the bar may use non-ASCII; an ambiguous-width marker breaks alignment"
    assert "+2 more accounts" in _table([mk(str(i), {"7d": i}) for i in range(6)], 80, 4)[0][-1]
    # an account with nothing to meter keeps its row and says why
    noted, _ = _table([mk("a", {"7d": 5}), mk("b", "no usage")], 80)
    assert "no usage" in noted[1] and noted[1].startswith("b")
    _guard_holds()
    _choices_hold()
    _moving_accounts_is_safe()
    _install_leaves_settings_intact()
    _login_does_not_lose_a_login()
    print("ok")


def _pace_reads_the_trail():
    """A projection is only as honest as the window it is drawn from."""
    import tempfile
    global USAGE
    real, now = USAGE, int(time.time())
    with tempfile.TemporaryDirectory() as d:
        USAGE = Path(d)
        acct, reset = {"name": "t"}, now + 3600 * 3
        trail = lambda rows: (USAGE / "t.trail.jsonl").write_text(
            "\n".join(json.dumps(r) for r in rows) + "\n")

        assert pace(acct, reading([("7d", 50)], resets=reset)) is None, "no trail, no claim"
        trail([{"at": now - 7200, "pct": 40, "resets": reset},
               {"at": now, "pct": 60, "resets": reset}])
        p = pace(acct, reading([("7d", 60)], resets=reset))
        assert round(p["per_hour"]) == 10 and round(p["projected"]) == 90, p
        assert "90%" in _pace_text(p)

        # a reading from the previous window must not be projected into this one
        assert pace(acct, reading([("7d", 60)], resets=reset + 99)) is None
        # nothing spent means nothing to extrapolate, not a projection of zero
        trail([{"at": now - 7200, "pct": 60, "resets": reset},
               {"at": now, "pct": 60, "resets": reset}])
        assert pace(acct, reading([("7d", 60)], resets=reset)) is None

        # the warning is about time, not percentage: below the threshold but minutes
        # from the wall must still warn, and high but barely moving must not
        cfg = {"accounts": [], "block_at": 95}
        fast = reading([("7d", 70)], resets=reset, paid_on=True)
        trail([{"at": now - 3600, "pct": 10, "resets": reset},
               {"at": now, "pct": 70, "resets": reset}])
        assert pace(acct, fast)["hits_at"] - now < WARN_WITHIN, "60%/h from 70% is minutes away"
        trail([{"at": now - 7200, "pct": 68, "resets": reset},
               {"at": now, "pct": 70, "resets": reset}])
        assert pace(acct, fast)["hits_at"] - now > WARN_WITHIN, "1%/h from 70% is not"
    USAGE = real


def _moving_accounts_is_safe():
    """rename moves files and remove --purge deletes a directory.

    Everything else here is a wrong answer; these two are a lost account, so they are
    exercised against a real temporary tree rather than reasoned about.
    """
    import contextlib
    import io
    import tempfile
    global OMS, CFG, USAGE
    keep = (OMS, CFG, USAGE)
    with tempfile.TemporaryDirectory() as d, contextlib.redirect_stdout(io.StringIO()):
        OMS = Path(d)
        CFG, USAGE = OMS / "config.json", OMS / "usage"
        home = OMS / "accounts" / "one"
        home.mkdir(parents=True)
        (home / "auth.json").write_text("{}")          # stands in for a login
        USAGE.mkdir()
        (USAGE / "one.json").write_text('{"at": 1}')
        (USAGE / "one.cache.json").write_text('{"v": 0}')
        cfg = {"accounts": [{"name": "one", "vendor": "codex", "dir": str(home)}],
               "block_at": 95, "priority": ["one"]}

        cmd_rename(cfg, ["one", "two"])
        moved = OMS / "accounts" / "two"
        assert moved.is_dir() and (moved / "auth.json").exists(), "the login must come along"
        assert not home.exists(), "and not be left behind in the old name"
        assert cfg["accounts"][0]["dir"] == str(moved), "config must point at where it went"
        assert (USAGE / "two.json").exists() and not (USAGE / "one.json").exists(), \
            "recorded usage follows the name, or the account reads as never used"
        assert (USAGE / "two.cache.json").exists()

        outside = Path(d) / "not-ours"
        outside.mkdir()
        cfg["accounts"].append({"name": "elsewhere", "vendor": "codex", "dir": str(outside)})
        cmd_remove(cfg, ["elsewhere", "--purge"])
        assert outside.is_dir(), "--purge must never delete a directory oms did not create"

        cmd_remove(cfg, ["two", "--purge"])
        assert not moved.exists(), "but must delete one it did"
        assert not (USAGE / "two.json").exists(), "and take the usage with it"
        assert cfg["accounts"] == [] and "priority" not in cfg, \
            "a removed account must not linger in the pick order"
    OMS, CFG, USAGE = keep


def _install_leaves_settings_intact():
    """`oms install` edits a file oms does not own.

    Everything else in settings.json belongs to Claude Code and to whatever the user put
    there. Losing a key, or replacing a status line someone already had, is not an oms
    problem the user can see - it is their editor quietly behaving differently.
    """
    import contextlib
    import io
    import tempfile
    global DEFAULT_CLAUDE_DIR
    keep = DEFAULT_CLAUDE_DIR
    with tempfile.TemporaryDirectory() as d, contextlib.redirect_stdout(io.StringIO()):
        DEFAULT_CLAUDE_DIR = Path(d)
        f = DEFAULT_CLAUDE_DIR / "settings.json"
        theirs = {"model": "opus", "permissions": {"allow": ["Bash(ls:*)"]},
                  "statusLine": {"type": "command", "command": "~/mine.sh"}}
        f.write_text(json.dumps(theirs))

        cmd_install({}, [])
        after = json.loads(f.read_text())
        assert after.get("model") == "opus" and after.get("permissions") == theirs["permissions"], \
            f"install dropped settings that were not its business: {sorted(after)}"
        assert "~/mine.sh" in after["statusLine"]["command"], \
            "a status line already there must be chained, not replaced"
        assert "statusline" in after["statusLine"]["command"]

        once = f.read_text()
        cmd_install({}, [])
        assert f.read_text() == once, "running install twice must not stack it on itself"

        f.unlink()
        cmd_install({}, [])          # and it must cope with no settings file at all
        assert "statusline" in json.loads(f.read_text())["statusLine"]["command"]
    DEFAULT_CLAUDE_DIR = keep


def _login_does_not_lose_a_login():
    """A login that cannot be registered must still be findable.

    By the time naming happens the user has completed a browser flow. Failing there with
    a traceback, and no word of where the credential went, is the most expensive moment
    in the tool to fail badly at.
    """
    import contextlib
    import io
    import tempfile
    global OMS, CFG, USAGE
    keep, said = (OMS, CFG, USAGE), []
    real_run, real_installed = subprocess.run, installed
    with tempfile.TemporaryDirectory() as d, contextlib.redirect_stdout(io.StringIO()):
        OMS = Path(d)
        CFG, USAGE = OMS / "config.json", OMS / "usage"
        orphan = OMS / "accounts" / "codex-2"           # an earlier login, interrupted
        orphan.mkdir(parents=True)
        (orphan / "auth.json").write_text("{}")
        globals()["installed"] = lambda v: True
        globals()["subprocess"].run = lambda *a, **k: type("R", (), {"returncode": 0})()
        real_die, globals()["die"] = die, lambda m: (said.append(m), sys.exit(1))[1]
        try:
            cmd_login({"accounts": [], "block_at": 95}, ["codex"])
        except SystemExit:
            pass
        finally:
            globals()["die"] = real_die
        assert said, "a name collision must be reported, not raised as OSError"
        assert "pending" in said[0], "and must say where the new login was left"
        assert orphan.exists(), "and must not overwrite the profile already there"
    OMS, CFG, USAGE = keep
    globals()["subprocess"].run, globals()["installed"] = real_run, real_installed


def _choices_hold():
    """How run and auto behave as readings age. Both reversed silently once already.

    The rule they encode: an old reading is not evidence, so it must not be *chosen* on
    while anything better exists - but it is also not a fault, so it must never stop a
    launch. Those two pull in opposite directions, which is how 0.30.0 managed to get
    both wrong at once.
    """
    global usage, usage_all
    real_usage, real_all, launched, notes = usage, usage_all, [], []
    fresh = {"name": "fresh", "vendor": "codex", "dir": "/tmp"}
    old = {"name": "old", "vendor": "codex", "dir": "/tmp", "paid_overflow": True}
    readings = {"fresh": reading([("5h", 50)], age=60),
                "old": reading([("5h", 10)], age=3 * 86400, paid_on=True)}
    usage = lambda a: readings[a["name"]]
    usage_all = lambda accounts: [readings[a["name"]] for a in accounts]
    real_exec, os.execvpe = os.execvpe, lambda f, a, e: launched.append(a[0])
    quiet, sys.stderr = sys.stderr, type("W", (), {"write": notes.append, "flush": lambda s: None})()
    try:
        cmd_run({"accounts": [old], "block_at": 95}, ["old"])
        assert launched, "an aged reading must not stop a launch"
        assert any("old information" in n for n in notes), "but it must be said out loud"

        # the stale one is emptier; freshness has to beat a better-looking old number
        launched.clear()
        cmd_auto({"accounts": [old, fresh], "block_at": 95}, ["codex"])
        assert launched == ["codex"], launched
        assert any("fresh" in n for n in notes), f"auto chose on a stale reading: {notes}"

        # nothing fresh anywhere: pick regardless rather than refuse
        launched.clear(), notes.clear()
        try:
            cmd_auto({"accounts": [old], "block_at": 95}, ["codex"])
        except SystemExit:
            # die() writes into the captured stderr, so without this the failure would
            # be an exit code and no explanation
            raise AssertionError(
                "auto refused when every reading was old: " + "".join(notes).strip())
        assert launched, "auto refused when every reading was old"
        assert any("last read" in n for n in notes), "and did not say the reading was old"
    finally:
        usage, usage_all, os.execvpe, sys.stderr = real_usage, real_all, real_exec, quiet


def _guard_holds():
    """The whole point, exercised end to end: a launch that would bill must not happen.

    `blocked()` was tested in isolation, which proves the judgement and not that anything
    obeys it. These drive cmd_run and cmd_auto with the launch intercepted, so a future
    refactor that drops the check fails here instead of on somebody's bill.
    """
    global usage, usage_all
    real_usage, real_all, launched = usage, usage_all, []
    at_risk = {"name": "risky", "vendor": "codex", "dir": "/tmp", "paid_overflow": True}
    safe = {"name": "safe", "vendor": "codex", "dir": "/tmp"}
    cfg = {"accounts": [at_risk, safe], "block_at": 95}
    readings = {
        "risky": reading([("7d", 99)], paid_on=True),   # over the line and billable
        "safe": reading([("7d", 99)], paid_on=False),   # equally full, but free
    }
    usage = lambda a: readings[a["name"]]
    usage_all = lambda accounts: [readings[a["name"]] for a in accounts]
    real_exec, os.execvpe = os.execvpe, lambda f, a, e: launched.append(a)
    real_die, exits = die, []

    def fake_die(msg):
        exits.append(msg)
        raise SystemExit(1)

    globals()["die"] = fake_die
    try:
        assert blocked(at_risk, readings["risky"], 95), "99% on a billable plan is blocked"
        assert not blocked(safe, readings["safe"], 95), "a plan that cannot bill is never blocked"

        try:
            cmd_run(cfg, ["risky"])
        except SystemExit:
            pass
        assert not launched, "cmd_run launched an account that would bill"
        assert exits and "blocked" in exits[-1]

        cmd_run(cfg, ["risky"], check=False)
        assert launched, "--force must still launch"

        # a warning points where the pick order points, and says if that can bill too
        readings["risky"] = reading([("7d", 90)], paid_on=True)
        expiring = {"name": "expiring", "vendor": "codex", "dir": "/tmp",
                    "paid_overflow": True}
        readings["expiring"] = reading([("5h", 40)], paid_on=True)
        alt = _best_alt({"accounts": [at_risk, expiring, safe], "block_at": 95}, at_risk)
        assert "expiring" in alt, "the window that expires is spent before a fixed pool"
        assert "can bill as well" in alt, "and the user is told it can charge"

        launched.clear()
        quiet, sys.stderr = sys.stderr, open(os.devnull, "w")
        try:
            cmd_auto(cfg, ["codex"])
        finally:
            sys.stderr.close()
            sys.stderr = quiet
        assert launched and "safe" not in str(exits[-1:]), "auto must route around the blocked one"
    finally:
        usage, usage_all, os.execvpe = real_usage, real_all, real_exec
        globals()["die"] = real_die


CMDS = {"status": cmd_status, "add": cmd_add, "run": cmd_run, "auto": cmd_auto,
        "login": cmd_login, "rename": cmd_rename, "priority": cmd_priority,
        "config": cmd_config, "set": cmd_set, "remove": cmd_remove, "doctor": cmd_doctor,
        "handoff": cmd_handoff, "check": cmd_check,
        "statusline": cmd_statusline, "install": cmd_install, "env": cmd_env,
        "models": cmd_models, "pi": cmd_pi, "core": cmd_core}
USAGE_TEXT = __doc__ + """
  oms login <provider> [<name>]        install if missing, log in, name, prime it
  oms remove <name> [--purge]          unregister an account
  oms add <name> <provider> [--dir PATH] [--paid-overflow yes|no]
  oms install                          wire usage recording into ~/.claude/settings.json
  oms status [--json]                  what every account has left
  oms doctor                           check the wiring that fails silently
  oms run [--force] <name> [args...]   launch one account
  oms auto <provider> [args...]        launch the best account that can't bill you
  oms auto <provider> --dry-run        say which one, and launch nothing
  oms rename <old> <new>               rename an account, keeping its usage history
  oms priority [<name>... | --auto]    show or set the order `oms auto` picks in
  oms config                           every setting, global and per account
  oms models [account|filter]          list available core models
  oms set [<account>] key=value ...    change any of them
  oms handoff [- | --clear]            the brief carried into the next session
  oms run <name> --handoff             launch carrying that brief as the first prompt
  oms env <name>                       print the export line for a shell
  oms pi <account|gemini> [args...]    launch Pi pinned to an OMS account
  oms core install                     install verified shared-core binary
  oms core [start|stop|status]         manage the shared provider sidecar
  oms core login <provider> [account]  login, bind, and sync automatically
  oms core sync                        apply OMS guards to core credentials
  oms core run <agent> <account> ...   launch Claude/Codex through the core
"""

if __name__ == "__main__":
    argv = sys.argv[1:]
    if argv and argv[0] == "--selftest":
        selftest(); sys.exit(0)
    if not argv or argv[0] not in CMDS:
        print(USAGE_TEXT); sys.exit(0 if argv else 1)
    try:
        if argv[0] == "run":
            rest = [x for x in argv[1:] if x != "--force"]
            cmd_run(load(), rest, check="--force" not in argv[1:])
        else:
            CMDS[argv[0]](load(), argv[1:])
    except BrokenPipeError:
        # `oms status | head` closes the pipe early. Python would otherwise print a
        # traceback and then complain again while flushing at exit, turning the most
        # ordinary thing you can do with a CLI into an error report.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
